            }
          ],
          "citations": [
            {
              "source": "https://whgazetteer.org/example/source/charter-c1200",
              "locator": "witness list"
            }
          ],
          "certainty": 0.4,
          "meta": {
            "targetAttestation": "https://whgazetteer.org/example/attestation/newton-a",
            "metaType": "https://w3id.org/plato#AlternativeTo"
          },
          "notes": "The same mention read as the other Newton. With plato:AlternativeTo, the two are one piece of evidence, at most one of them right, not two."
