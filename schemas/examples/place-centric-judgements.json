        {
          "@id": "https://whgazetteer.org/example/attestation/newton-a",
          "names": [
            {
              "toponym": "Neuton"
            }
          ],
          "citations": [
            {
              "source": {
                "@id": "https://whgazetteer.org/example/source/charter-c1200",
                "title": "Charter, c. 1200"
              },
              "locator": "witness list"
            }
          ],
          "certainty": 0.6,
          "notes": "The charter names Neuton without saying which of two Newtons it means."
        }
      ]
    },
    {
      "@id": "https://whgazetteer.org/example/entity/newton-on-the-hill",
