              "source": {
                "@id": "https://whgazetteer.org/example/source/market-survey-1967",
                "title": "A survey of markets, 1967"
              },
              "locator": "p. 470",
              "citationFunction": "http://purl.org/spar/cito/citesAsEvidence"
