  {
    "@id": "https://w3id.org/plato#StanceDoubted",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The source raises it and declines to settle it. Not a denial, which is plato:negated."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#SourceStanceScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "doubted"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/plato#SourceStanceScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#TranscriptionReconstructable",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Part of the value is lost, damaged or abbreviated, but can be supplied with confidence."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#TranscriptionCompletenessScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "reconstructable"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/plato#TranscriptionCompletenessScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Retracts",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The target attestation is withdrawn: it no longer holds, and is kept only so that earlier states of the gazetteer can be reproduced. A Gazetteer retracts the attestations it made, such as a bad import; a maintainer signs for the Gazetteer, and is recorded as the retraction's contributor. It is not a claim about the person who first wrote the attestation. To dispute an attestation made by another Gazetteer, use plato:Contradicts. A tool showing the current state leaves a retracted attestation out. A retraction is itself an attestation: retracting it withdraws the withdrawal, and the target holds again."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#MetaTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "retracts"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/plato#MetaTypeScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#LessCertain",
    "@type": [
      "https://w3id.org/plato#CertaintyLevel",
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The statement is probable but not certain."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The statement is probable but not certain."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#CertaintyLevelScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "less certain"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/plato#CertaintyLevelScheme"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "less certain"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#LeadsTo",
    "@type": [
      "https://w3id.org/plato#RelationType",
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        A directed connection, from the subject (attests_about) to the target\n        (relates_to): one river flowing into another, a post road carrying\n        mail from one town to the next, letters sent from one city to\n        another. It joins two places; the reaches and legs of a network are\n        segments, whose direction is given by plato:BeginsAt and\n        plato:EndsAt. Not river-specific: a project declares its own narrower types ('flows\n        into', 'carries post to') with plato:broader_relation pointing here,\n        so that a consumer that knows only LeadsTo still follows them in the\n        right direction.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A directed connection, from the subject (attests_about) to the target (relates_to): one river flowing into another, a post road carrying mail from one town to the next, letters sent from one city to another. It joins two places; the reaches and legs of a network are segments, whose direction is given by plato:BeginsAt and plato:EndsAt. Not river-specific: a project declares its own narrower types ('flows into', 'carries post to') with plato:broader_relation pointing here, so that a consumer that knows only LeadsTo still follows them in the right direction."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#RelationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "leads_to"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "leads to"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/plato#RelationTypeScheme"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "leads to"
      }
    ],
    "https://w3id.org/plato#inverse_label": [
      {
        "@value": "reached_from"
      }
    ],
    "https://w3id.org/plato#relation_domain": [
      {
        "@value": "SpatialEntity"
      }
    ],
    "https://w3id.org/plato#relation_label": [
      {
        "@value": "leads_to"
      }
    ],
    "https://w3id.org/plato#relation_range": [
      {
        "@value": "SpatialEntity"
      }
    ]
  },
