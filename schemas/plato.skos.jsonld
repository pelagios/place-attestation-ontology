  {
    "@id": "https://w3id.org/plato#SplitInto",
    "@type": [
      "https://w3id.org/plato#RelationType",
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The subject ceased and was divided, from the attested date, into new\n        entities that include the target: a municipality divided into two.\n        One attestation for each, with the same date. Land shared out among\n        entities that already existed is plato:AbsorbedBy, once for each.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/plato#SucceededBy"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The subject ceased and was divided, from the attested date, into new entities that include the target: a municipality divided into two. One attestation for each, with the same date. Land shared out among entities that already existed is plato:AbsorbedBy, once for each."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#RelationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "split_into"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "split into"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "split into"
      }
    ],
    "https://w3id.org/plato#broader_relation": [
      {
        "@id": "https://w3id.org/plato#SucceededBy"
      }
    ],
    "https://w3id.org/plato#inverse_label": [
      {
        "@value": "split_from"
      }
    ],
    "https://w3id.org/plato#relation_domain": [
      {
        "@value": "SpatialEntity"
      }
    ],
    "https://w3id.org/plato#relation_label": [
      {
        "@value": "split_into"
      }
    ],
