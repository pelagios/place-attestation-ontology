      },
      {
        "@id": "https://w3id.org/plato#Uncertain"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#TranscriptionInaccurate",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The transcription departs from what the source shows, by misreading or error, but is a reading of something the source contains."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#TranscriptionAccuracyScheme"
