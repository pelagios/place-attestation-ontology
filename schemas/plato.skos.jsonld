      {
        "@language": "en",
        "@value": "The target person or group worked, or held office, at the subject, for the attested timespan: Linked Traces' heldOffice, and work generally."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The target person or group worked, or held office, at the subject, for the attested timespan: Linked Traces' heldOffice, and work generally."
      }
