  {
    "@id": "https://w3id.org/plato#AttributionInferred",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The source was given as ibidem or idem and resolved by an editor, so the attribution is inferred rather than stated."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#AttributionStatusScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "attribution inferred"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/plato#AttributionStatusScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#AbsorbedBy",
    "@type": [
      "https://w3id.org/plato#RelationType",
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The subject ceased and its territory, or a part of it, passed to the\n        target, which carried on under its own identity, from the attested\n        date: a municipality annexed by its neighbour, or dissolved and\n        shared out among several, one attestation for each. The target does\n        not become a different entity by absorbing, so it has no attestation\n        of its own for the event; a source that says the larger unit was\n        thereby enlarged is saying something about its extent, which belongs\n        in a geometry or property value with its own timespan.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/plato#SucceededBy"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The subject ceased and its territory, or a part of it, passed to the target, which carried on under its own identity, from the attested date: a municipality annexed by its neighbour, or dissolved and shared out among several, one attestation for each. The target does not become a different entity by absorbing, so it has no attestation of its own for the event; a source that says the larger unit was thereby enlarged is saying something about its extent, which belongs in a geometry or property value with its own timespan."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#RelationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "absorbed_by"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "absorbed by"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "absorbed by"
      }
    ],
    "https://w3id.org/plato#broader_relation": [
      {
        "@id": "https://w3id.org/plato#SucceededBy"
      }
    ],
    "https://w3id.org/plato#inverse_label": [
      {
        "@value": "absorbed"
      }
    ],
    "https://w3id.org/plato#relation_domain": [
      {
        "@value": "SpatialEntity"
      }
    ],
    "https://w3id.org/plato#relation_label": [
      {
        "@value": "absorbed_by"
      }
    ],
    "https://w3id.org/plato#relation_range": [
      {
        "@value": "SpatialEntity"
      }
    ]
  },
