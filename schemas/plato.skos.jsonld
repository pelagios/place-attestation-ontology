      {
        "@language": "en",
        "@value": "attribution status"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#hasTopConcept": [
      {
        "@id": "https://w3id.org/plato#AttributionInferred"
      },
      {
        "@id": "https://w3id.org/plato#AttributionStated"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#TransferredTo",
    "@type": [
      "https://w3id.org/plato#RelationType",
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Part of the subject's land passed to the target from the attested\n        date, and both carry on: a boundary change between two municipalities,\n        or a new municipality formed from part of a continuing one. The target\n        may therefore be an entity that already existed, or one that came into\n        being by the transfer. Neither is the other's successor, so this is\n        not a plato:SucceededBy; and if the subject ceased, it is\n        plato:AbsorbedBy or plato:SplitInto instead. The date is the\n        attestation's timespan. The land itself is not recorded here: a\n        geometry on this attestation would read as the subject's own extent.\n        Each party's extent before and after is its own geometry attestation,\n        with its own timespan; a source's description of what moved ('the\n        hamlet of Zuidwijk') is plato:source_label.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Part of the subject's land passed to the target from the attested date, and both carry on: a boundary change between two municipalities, or a new municipality formed from part of a continuing one. The target may therefore be an entity that already existed, or one that came into being by the transfer. Neither is the other's successor, so this is not a plato:SucceededBy; and if the subject ceased, it is plato:AbsorbedBy or plato:SplitInto instead. The date is the attestation's timespan. The land itself is not recorded here: a geometry on this attestation would read as the subject's own extent. Each party's extent before and after is its own geometry attestation, with its own timespan; a source's description of what moved ('the hamlet of Zuidwijk') is plato:source_label."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#RelationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "transferred_to"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "transferred to"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/plato#RelationTypeScheme"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "transferred to"
      }
    ],
    "https://w3id.org/plato#inverse_label": [
      {
        "@value": "received_from"
      }
    ],
    "https://w3id.org/plato#relation_domain": [
      {
        "@value": "SpatialEntity"
      }
    ],
    "https://w3id.org/plato#relation_label": [
      {
        "@value": "transferred_to"
      }
    ],
    "https://w3id.org/plato#relation_range": [
      {
        "@value": "SpatialEntity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Certain",
    "@type": [
      "https://w3id.org/plato#CertaintyLevel",
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The statement is certain: the source, or the contributor, has no doubt of it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The statement is certain: the source, or the contributor, has no doubt of it."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#CertaintyLevelScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "certain"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/plato#CertaintyLevelScheme"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "certain"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#AlternativeTo",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "This attestation and the target are alternative readings of the same evidence: at most one of them is right. Each keeps its own certainty. Link every alternative in a set to the same first one. A set of alternatives is one piece of evidence, not several, so it must be counted once."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#MetaTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "alternative to"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/plato#MetaTypeScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Supersedes",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Replaces the target attestation with newer information."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#MetaTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "supersedes"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/plato#MetaTypeScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#MemberOf",
    "@type": [
      "https://w3id.org/plato#RelationType",
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The subject is a member of the target route, itinerary or network: a\n        station on a road, a stop on a journey, a port in a trade network, a\n        segment of a river system. Its position, where the source gives one,\n        is plato:sequence on the same attestation. A route may be a member of\n        another route (one stage of a pilgrimage), but not, through any chain\n        of memberships, of itself. Not containment: a town on a road is not\n        within it, and a network's members need not lie inside anything.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The subject is a member of the target route, itinerary or network: a station on a road, a stop on a journey, a port in a trade network, a segment of a river system. Its position, where the source gives one, is plato:sequence on the same attestation. A route may be a member of another route (one stage of a pilgrimage), but not, through any chain of memberships, of itself. Not containment: a town on a road is not within it, and a network's members need not lie inside anything."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#RelationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "member_of"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "member of"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/plato#RelationTypeScheme"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "member of"
      }
    ],
    "https://w3id.org/plato#inverse_label": [
      {
        "@value": "has_member"
      }
    ],
    "https://w3id.org/plato#relation_domain": [
      {
        "@value": "SpatialEntity"
      }
    ],
    "https://w3id.org/plato#relation_label": [
      {
        "@value": "member_of"
      }
    ],
    "https://w3id.org/plato#relation_range": [
      {
        "@value": "SpatialEntity (a route, itinerary or network)"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#EvidenceSpan",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The span of the evidence: the dates of the earliest and latest documents that mention the entity. Not the dates of the entity itself."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#TimespanRoleScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "evidence span"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/plato#TimespanRoleScheme"
      }
    ]
  },
  {
