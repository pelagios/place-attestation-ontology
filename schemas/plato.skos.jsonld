      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Between two anchors, given as two values of plato:relative_to, in no particular order."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#RelativeQualifierScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "between"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/plato#RelativeQualifierScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#SucceededBy",
    "@type": [
      "https://w3id.org/plato#RelationType",
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The target took the subject's place from the attested date: a\n        parish replaced by a successor parish, a province by another. The\n        general succession, for a source that says an entity was succeeded\n        without saying how. It does not claim that the two are the same\n        entity (that is an IdentityRelation) or that one contains the other\n        (plato:ContainedIn). Use plato:MergedInto, plato:AbsorbedBy or\n        plato:SplitInto where the source says which kind of change it was;\n        each of those is also a SucceededBy.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The target took the subject's place from the attested date: a parish replaced by a successor parish, a province by another. The general succession, for a source that says an entity was succeeded without saying how. It does not claim that the two are the same entity (that is an IdentityRelation) or that one contains the other (plato:ContainedIn). Use plato:MergedInto, plato:AbsorbedBy or plato:SplitInto where the source says which kind of change it was; each of those is also a SucceededBy."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#RelationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://w3id.org/plato#MergedInto"
      },
      {
        "@id": "https://w3id.org/plato#AbsorbedBy"
      },
      {
        "@id": "https://w3id.org/plato#SplitInto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "succeeded_by"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "succeeded by"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/plato#RelationTypeScheme"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "succeeded by"
      }
    ],
    "https://w3id.org/plato#inverse_label": [
      {
        "@value": "succeeds"
      }
    ],
    "https://w3id.org/plato#relation_domain": [
      {
        "@value": "SpatialEntity"
      }
    ],
    "https://w3id.org/plato#relation_label": [
      {
        "@value": "succeeded_by"
      }
    ],
    "https://w3id.org/plato#relation_range": [
      {
        "@value": "SpatialEntity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#FormStatusScheme",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Starter concepts for plato:form_status. The status of the name form an attestation contributes."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
