[
  {
    "@id": "https://w3id.org/plato#Type",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        A classification or category for a SpatialEntity, typically drawn from a\n        controlled vocabulary such as the Getty Art & Architecture Thesaurus\n        (AAT), as one dataset uses it. A Type node stands for that usage and\n        may be reused within its dataset. Its IRI, if it has one, is the\n        dataset's own, or it is a blank node: never the vocabulary concept's\n        IRI, which goes in plato:type_identifier. Otherwise every dataset's\n        label, source wording and plato:scheme_version would merge onto the\n        concept in any combined graph.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2004/02/skos/core#Concept"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#contains_candidate",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Links a CandidateSet to a Candidate it publishes. The candidate set\n        profile carries these in its top-level candidates array, and this is\n        the property that array maps to.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#CandidateSet"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "contains candidate"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#Candidate"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#value_unit",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        URI of the unit of measurement, where the value has one — a QUDT unit\n        or a Wikidata unit item. Omitted for counts and dimensionless values.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#PropertyValue"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "value unit"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#StanceAsserted",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The source states it as so, on its own account. The default source stance, usually omitted."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#SourceStanceScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "asserted"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#authority_title",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Authority"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "title"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#RelativeQualifierScheme",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Starter concepts for plato:relative_qualifier. How a facet is defined relative to its anchor when bearing and distance are not applicable or not sufficient."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "relative qualifier"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#source_stance",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        How firmly the source itself asserts what this attestation bundles: a\n        concept in plato:SourceStanceScheme, plato:StanceAsserted (the default,\n        usually omitted), plato:StanceReported, plato:StanceTentative or\n        plato:StanceDoubted, or one a project declares. It records the source,\n        not whoever encodes it: plato:certainty and plato:certainty_level are\n        the contributor's or editor's confidence, and an editor may be quite\n        certain that a source hedged. Nor is it plato:attribution_status, which\n        says whether the source is named where the evidence occurs.\n\n        Doubt is not denial. A source that raises a thing and declines to\n        settle it is plato:StanceDoubted; one that says it is not so is\n        plato:negated. A source that passes on a claim and names whom it\n        reports can have that work cited as well.\n\n        It qualifies the attestation as a whole, as plato:negated does, so\n        bundle one facet per attestation where the source's stance differs\n        between facets. A consumer that cannot express a stance reads the\n        attestation as asserted, which overstates the source but does not\n        invert it. So, unlike plato:negated, no consumer is required to leave\n        it out, but a converter should report the loss.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "source stance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2004/02/skos/core#Concept"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Retracts",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The target attestation is withdrawn: it no longer holds, and is kept only so that earlier states of the gazetteer can be reproduced. For a claim its maker takes back, such as a bad import, where plato:Contradicts would read as one scholar disputing another. A tool showing the current state leaves a retracted attestation out. A retraction is itself an attestation: retracting it withdraws the withdrawal, and the target holds again."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#MetaTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "retracts"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Geometry",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        A spatial representation of a SpatialEntity's extent or location. Geometries\n        are independent, reusable entities. The same Geometry may be referenced\n        by multiple Attestations across different SpatialEntities or time periods.\n\n        Each Geometry is one GeoJSON geometry; a GeometryCollection is not\n        accepted, so a set of different kinds (a point and a polygon) is\n        several Geometry nodes. One attestation may attest several\n        geometries when one source gives them all, each with a\n        plato:geometry_role where they depict different things (a built\n        extent, a label position); a geometry from another source is\n        another attestation, since it has another provenance. See\n        examples/geometry-roles.ttl.\n\n        A geometry traced from a historical map, and placed in the world\n        through a georeference (a IIIF Georeference Annotation, such as one\n        made in Allmaps), is evidence of what the map shows, so it is\n        attested, not plato:computed. Its position depends on the map, on the\n        annotation, whose control points can be edited after the tracing,\n        and on the transformation fitted to them. So the attestation cites\n        both, and no new property is needed: the map as the evidence\n        (plato:citation_function cito:citesAsEvidence), with the canvas as\n        the plato:locator, and '#xywh=' added when the tracing is from a\n        region of it; and the annotation as a Source of its own, with the\n        annotation's IRI, plato:derived_from the map's Source, cited with\n        cito:usesMethodIn. The transformation (polynomial of order 1 to 3,\n        thin plate spline, projective, Helmert) and the number of control\n        points used go in the attestation's plato:notes, since the annotation\n        may since have changed. A position that is where the map writes a\n        name takes plato:geometry_role plato:LabelAnchor. The position of a\n        map symbol is a plato:RepresentativePoint, unless the map shows the\n        specific feature (a church drawn as such), when it is a\n        plato:FeaturePoint. See\n        schemas/examples/place-centric-georeference.json.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Geometry"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.opengis.net/ont/geosparql#Geometry"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#HasEnd",
    "@type": [
      "https://w3id.org/plato#RelationType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The subject segment has the target as one of its ends, in no\n        particular direction: a stretch of road between two towns, walked\n        either way. An undirected segment has two HasEnd attestations. Not\n        plato:ConnectedTo, which joins two places directly: were a segment\n        connected to its ends, every place would be two steps from its\n        neighbours.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "has end"
      }
    ],
    "https://w3id.org/plato#inverse_label": [
      {
        "@value": "one_end_of"
      }
    ],
    "https://w3id.org/plato#relation_domain": [
      {
        "@value": "SpatialEntity (a segment)"
      }
    ],
    "https://w3id.org/plato#relation_label": [
      {
        "@value": "has_end"
      }
    ],
    "https://w3id.org/plato#relation_range": [
      {
        "@value": "SpatialEntity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#end_latest",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The latest possible end date for this timespan. For certain dates,\n        this equals end_earliest. For uncertain dates, defines the end of\n        the uncertainty range for when the interval ended.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Timespan"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "end latest"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Literal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#spatial_precision",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Precision qualifier for this geometry: 'exact' (surveyed or GPS),\n        'approximate' (estimated from maps or descriptions), 'uncertain'\n        (multiple possible locations), 'historical_approximate' (based on\n        historical sources with inherent imprecision). Multiple values\n        possible for heterogeneous geometries.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Geometry"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "spatial precision"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#derived_from",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        This Source is a copy, transcript, edition, calendar or confirmation\n        of that one, or a work made from it. A later cartulary copy of a\n        charter, an inspeximus, or a printed edition of a manuscript is a\n        Source of its own, with its own source_timespan, derived_from the\n        document it transmits. An attestation should cite the Source it was\n        actually read in; the chain of derived_from links records what that\n        Source transmits. A work made from a source, which transmits none of\n        it as evidence, is derived_from it too: a count a project takes from\n        a register (see plato:computed), or the georeference of a map (see\n        plato:Geometry). How it is cited says which it is: a copy is cited as\n        the evidence, a georeference as the method used. The kind of\n        derivation (copy, edition, calendar, inspeximus, analysis) is not yet\n        distinguished; a sub-property or a small vocabulary can be added when\n        a project needs it.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Source"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "derived from"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#Source"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#property_label",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Human-readable label for the property (e.g. 'population')."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#PropertyValue"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "property label"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#period_label",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Human-readable label for this period (e.g., 'Byzantine period',\n        'Han Dynasty', 'Early Bronze Age'). Distinct from authority_title,\n        which may be more formal.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Period"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "period label"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Refines",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Provides more precise information than the target attestation."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#MetaTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "refines"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#transcription_accuracy",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        How faithfully a transcribed value (a name form, most often) renders\n        what the source shows: a concept in plato:TranscriptionAccuracyScheme,\n        plato:TranscriptionAccurate, plato:TranscriptionInaccurate or\n        plato:TranscriptionFalse. It judges the reading, not the source and not\n        the identification: plato:form_status says how a form came to be, and\n        plato:certainty how sure anyone is of the attestation, and neither says\n        how well the form was read. Pleiades records it for every name.\n\n        Like the other qualification properties it has no rdfs:domain, so a\n        transcribed coordinate or date can be judged the same way.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "transcription accuracy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2004/02/skos/core#Concept"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#contributor_orcid",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        ORCID identifier for person contributors. Can be provided in two formats:\n\n        1. Compact format: 0000-0000-0000-0000 (sixteen digits in groups of four)\n        2. URI format: https://orcid.org/0000-0000-0000-0000 (preferred)\n\n        The URI format (https://orcid.org/...) is preferred and required for\n        proper linked data representation. ORCID is particular about always\n        including the https:// protocol and domain prefix.\n\n        While optional in the general ontology, specific implementations\n        (e.g., WHG) may require ORCID for person contributors to ensure\n        proper attribution and citation.\n\n        ORCID provides persistent identification for researchers, enabling\n        proper credit and reducing name ambiguity.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Contributor"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "ORCID"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#attests_name",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Links an Attestation to a Name it asserts for the SpatialEntity. An attestation\n        may assert multiple names (e.g., primary name and variants) or no name\n        at all (e.g., geometry-only attestations).\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "attests name"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#Name"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#TypeNetwork",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A set of places and the connections between them, in no single order: a river system, a canal network, a correspondence network."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#EntityKindScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "network"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#toponym",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The name string itself in its original script. This is the primary\n        property of a Name entity. Required for all Name instances.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Name"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "toponym"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#authority_version",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Version identifier for tracking upstream authority updates."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Authority"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "version"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#contains_identity_relation",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Links a Gazetteer to an IdentityRelation asserted within it. The\n        submission profiles carry identity relations at the top level of a\n        document, beside the entities and attestations, and this is the\n        property that top level maps to.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Gazetteer"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "contains identity relation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#IdentityRelation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#has_citation",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Links an Attestation to a Citation: its qualified use of one\n        Authority, with a locator and an attribution status. An attestation\n        may have several, one per source it rests on.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has citation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#Citation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#ConnectedTo",
    "@type": [
      "https://w3id.org/plato#RelationType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The subject and target are directly connected, in no particular\n        direction: an attestation that A is connected to B says the same as\n        one that B is connected to A. For a connection that runs one way, use\n        plato:LeadsTo. A connection known in both directions from sources that\n        each give one is better recorded as two LeadsTo attestations, each\n        with its own source, than as one ConnectedTo.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "connected to"
      }
    ],
    "https://w3id.org/plato#inverse_label": [
      {
        "@value": "connected_to"
      }
    ],
    "https://w3id.org/plato#relation_domain": [
      {
        "@value": "SpatialEntity"
      }
    ],
    "https://w3id.org/plato#relation_label": [
      {
        "@value": "connected_to"
      }
    ],
    "https://w3id.org/plato#relation_range": [
      {
        "@value": "SpatialEntity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#value_type",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        URI declaring the shape of a structured value, so that a consumer can\n        tell whether it understands the value before attempting to read it.\n        Omitted for literal values.\n\n        Not every attribute a source states is scalar. A market's trading day\n        — 'the Monday after Whitsun, for three days' — is a recurrence rule\n        anchored to a moveable feast, and flattening it to a string would\n        reproduce the loss this class exists to prevent. The ontology stays\n        agnostic about such shapes: it records which shape is in use and\n        leaves the definition to the vocabulary that owns it.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#PropertyValue"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "value type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#gazetteer_owner",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Gazetteer"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "owner"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#Contributor"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#SubjectOf",
    "@type": [
      "https://w3id.org/plato#RelationType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The target is about the subject: an archival file, a site record, a report or a publication, identified by its address. Not a citation of the target as evidence for another statement, which is plato:has_citation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "subject of"
      }
    ],
    "https://w3id.org/plato#inverse_label": [
      {
        "@value": "about"
      }
    ],
    "https://w3id.org/plato#relation_domain": [
      {
        "@value": "SpatialEntity"
      }
    ],
    "https://w3id.org/plato#relation_label": [
      {
        "@value": "subject_of"
      }
    ],
    "https://w3id.org/plato#relation_range": [
      {
        "@value": "record, document or publication"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#identity_certainty",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Confidence in the identity assertion, from 0.0 to 1.0. This is\n        the epistemic certainty of the asserter, distinct from identity_type\n        which describes the semantic nature of the relationship.\n        A closeMatch can have high certainty ('I'm confident these are\n        close but not exact') and an exactMatch can have low certainty\n        ('I think they're identical but I'm not sure').\n\n        Any XSD numeric datatype is accepted, from 0 to 1 (xsd:decimal, xsd:double,\n        xsd:float, xsd:integer and the others), so it has no rdfs:range.\n        PLATO tools writes a whole number as xsd:integer and any other as\n        xsd:double, as JSON-LD does.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#IdentityRelation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "identity certainty"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#DepictedIn",
    "@type": [
      "https://w3id.org/plato#RelationType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The subject is shown in the target: a photograph, map, plan, drawing or other image, identified by its address in a collection."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "depicted in"
      }
    ],
    "https://w3id.org/plato#inverse_label": [
      {
        "@value": "depicts"
      }
    ],
    "https://w3id.org/plato#relation_domain": [
      {
        "@value": "SpatialEntity"
      }
    ],
    "https://w3id.org/plato#relation_label": [
      {
        "@value": "depicted_in"
      }
    ],
    "https://w3id.org/plato#relation_range": [
      {
        "@value": "image, map or drawing"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#InPersonalName",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The form occurs only as an element of a personal name, a surname or by-name; the (p) of the place-name surveys."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#OccurrenceContextScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "in personal name"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Beyond",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "On the far side of the anchor from the point of view of the source."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#RelativeQualifierScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "beyond"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#fuzziness_note",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Free-text explanation of the nature of ontological fuzziness\n        (e.g. 'regional boundary was never formally demarcated',\n        'name used inconsistently across contemporary sources',\n        'transition was gradual rather than a discrete event').\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "fuzziness note"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#ipa",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        International Phonetic Alphabet representation of the name's\n        pronunciation. Enables phonetic search and comparison across scripts\n        and languages.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Name"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "IPA"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#attests_property",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Links an Attestation to a PropertyValue it asserts of the SpatialEntity — a\n        population, a valuation, an elevation, a market's trading day. An\n        attestation may assert several properties or none.\n\n        These are among the commonest things a source says about an entity, and\n        they carry exactly the provenance and temporal scoping the attestation\n        pattern exists to handle: a population figure is a claim, by a named\n        source, about one SpatialEntity, over a Timespan, with a certainty. The\n        attestation's own timespans scope the property as they scope every\n        other facet in the bundle.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "attests property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#PropertyValue"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#MemberOf",
    "@type": [
      "https://w3id.org/plato#RelationType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The subject is a member of the target route, itinerary or network: a\n        station on a road, a stop on a journey, a port in a trade network, a\n        segment of a river system. Its position, where the source gives one,\n        is plato:sequence on the same attestation. A route may be a member of\n        another route (one stage of a pilgrimage), but not, through any chain\n        of memberships, of itself. Not containment: a town on a road is not\n        within it, and a network's members need not lie inside anything.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "member of"
      }
    ],
    "https://w3id.org/plato#inverse_label": [
      {
        "@value": "has_member"
      }
    ],
    "https://w3id.org/plato#relation_domain": [
      {
        "@value": "SpatialEntity"
      }
    ],
    "https://w3id.org/plato#relation_label": [
      {
        "@value": "member_of"
      }
    ],
    "https://w3id.org/plato#relation_range": [
      {
        "@value": "SpatialEntity (a route, itinerary or network)"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#ResidenceOf",
    "@type": [
      "https://w3id.org/plato#RelationType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The target person or group lived at the subject, for the attested timespan."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "residence of"
      }
    ],
    "https://w3id.org/plato#inverse_label": [
      {
        "@value": "resided_at"
      }
    ],
    "https://w3id.org/plato#relation_domain": [
      {
        "@value": "SpatialEntity"
      }
    ],
    "https://w3id.org/plato#relation_label": [
      {
        "@value": "residence_of"
      }
    ],
    "https://w3id.org/plato#relation_range": [
      {
        "@value": "person or group"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#edtf_string",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Extended Date/Time Format (EDTF) representation of this timespan.\n        Provides standardized string encoding for interchange with systems\n        using EDTF. Optional but recommended for interoperability with library\n        and archival systems. Example: '1453-05-29/1453-05-29' or '1450~/1453~'\n        for approximate dates.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Timespan"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "EDTF string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#LessCertain",
    "@type": [
      "https://w3id.org/plato#CertaintyLevel"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The statement is probable but not certain."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "less certain"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#CandidateSet",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The matches one run of matching software suggested for a dataset's\n        SpatialEntities (plato:candidates_for), published together for people\n        to review and for the dataset's identity relations to point at\n        (plato:promoted_from). A Candidate is published only in a candidate\n        set, never in a Gazetteer: a Gazetteer holds claims, and a Candidate\n        is a claim by no one.\n\n        A candidate set is issued once (dcterms:issued) and frozen from then\n        on: no Candidate in it is changed or deleted, and a later run is a new\n        set. A dataset whose identity relations cite a candidate set should\n        have that set published wherever the dataset is, so that\n        promoted_from can be followed; a validator that has the set should\n        warn when a promoted_from names no Candidate in it.\n\n        As a dcat:Dataset it is titled with dcterms:title and licensed with\n        dcterms:license, as a Gazetteer is. It is disjoint from Gazetteer, so\n        it carries none of a Gazetteer's own properties (a status, an owner):\n        its date of issue says from when it is frozen.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Candidate Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/dcat#Dataset"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "https://w3id.org/plato#Gazetteer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#property_type",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        URI of the property in an external vocabulary — a Wikidata property,\n        a CIDOC-CRM property, or a project vocabulary term (e.g.\n        <https://www.wikidata.org/wiki/Property:P1082> for population).\n        Keeping the vocabulary external rather than enumerating attributes in\n        this ontology is what allows the model to carry attributes it has\n        never heard of.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#PropertyValue"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "property type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#licence",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://purl.org/dc/terms/isReplacedBy": [
      {
        "@id": "http://purl.org/dc/terms/license"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Deprecated: use dcterms:license. It could be given only to a Dataset,\n        it had no route in PLATO JSON, and it was a literal where a\n        Gazetteer's dcterms:license points at the licence itself. So the\n        licence of a cited source had no way into the data. dcterms:license has\n        no domain, so it serves every Authority and the Gazetteer alike, and\n        says nothing about what kind of thing is licensed. Kept for one release\n        under the deprecation policy.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Dataset"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "licence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
      }
    ],
    "http://www.w3.org/2002/07/owl#deprecated": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": true
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#period_periodo_uri",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Link to a PeriodO period definition for this Period authority.\n        When present, indicates this Period aligns with a standardized PeriodO\n        definition. The PeriodO record provides authoritative temporal bounds,\n        spatial extent, and cultural context. Example: 'https://n2t.net/ark:/99152/p06v8w4rb38'\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Period"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "PeriodO URI"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#candidate_source",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Candidate"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "source entity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#SpatialEntity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#CertaintyLevel",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        A defined level of certainty for use in attestations, allowing\n        projects to standardise their confidence vocabulary. An attestation or\n        facet points at one with plato:certainty_level. PLATO declares the three\n        levels of Linked Places Format (plato:Certain, plato:LessCertain,\n        plato:Uncertain); a project may declare its own.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Certainty Level"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/plato#Authority"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#EndsAt",
    "@type": [
      "https://w3id.org/plato#RelationType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The subject segment ends at the target: a leg of an itinerary at the\n        station it reaches, a river reach at its downstream confluence. See\n        plato:BeginsAt.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "ends at"
      }
    ],
    "https://w3id.org/plato#inverse_label": [
      {
        "@value": "end_of"
      }
    ],
    "https://w3id.org/plato#relation_domain": [
      {
        "@value": "SpatialEntity (a segment)"
      }
    ],
    "https://w3id.org/plato#relation_label": [
      {
        "@value": "ends_at"
      }
    ],
    "https://w3id.org/plato#relation_range": [
      {
        "@value": "SpatialEntity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#occurrence_context",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The capacity in which the attested form occurs in the source. Should\n        point to a concept in a SKOS concept scheme. The starter concepts are:\n\n        - plato:Direct: the form refers to the SpatialEntity directly. The\n          default, and usually omitted.\n        - plato:InPersonalName: the form occurs only as an element of a\n          personal name, a surname or by-name such as 'Willelmus de\n          Bonestou'. This is the '(p)' of the place-name surveys, and it is\n          weaker evidence for the name's currency, and for the entity's\n          existence, than a direct attestation. Nothing else in the record\n          distinguishes Bonestou the hundred from de Bonestou the man.\n        - plato:InFieldName: the form survives only as an element of a later\n          minor name, such as a field name.\n\n        The editorially resolved 'ibidem' of the surveys is not an occurrence\n        context. It is a statement about the citation, and belongs on the\n        Citation as plato:attribution_status.\n\n        Not a certainty. A '(p)' attestation may be entirely certain as an\n        attestation; what differs is the kind of evidence it constitutes, and\n        folding that into a lower plato:certainty would discard the reason.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "occurrence context"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2004/02/skos/core#Concept"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#TypeRoute",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "An ordered set of places making a way: a road, a sea lane, a pilgrimage route. Its timespan, if any, is when it was in use, not when anyone travelled it."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#EntityKindScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "route"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#AlternativeTo",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "This attestation and the target are alternative readings of the same evidence: at most one of them is right. Each keeps its own certainty. Link every alternative in a set to the same first one. A set of alternatives is one piece of evidence, not several, so it must be counted once."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#MetaTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "alternative to"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#ccodes",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        ISO 3166-1 alpha-2 codes of the modern countries whose territory\n        contains or overlaps this SpatialEntity, as in Linked Places Format.\n        A finding aid for search and matching, like a label: not evidence,\n        and not a claim about the past, so it needs no source. Where a\n        country is itself the subject of a historical claim (\"this town lay\n        in the Kingdom of Aragon\"), record it as a relation attestation.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#SpatialEntity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "country codes"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Attestation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        A bundle of evidence asserting that a particular SpatialEntity had a particular\n        Name, Geometry, Type, or combination thereof, during a particular\n        Timespan, according to a particular Authority. The Attestation node\n        carries only metadata; its semantic content is defined entirely by its\n        outgoing relationships.\n\n        IMPORTANT: Attestations are document nodes in the graph, not edges.\n        They are instances of plato:Attestation (a class), not instances of\n        owl:ObjectProperty. This design enables meta-attestations and full\n        provenance tracking.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#attests_timespan",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Links an Attestation to the Timespan during which the attested\n        properties (name, geometry, type) were applicable. Distinct from\n        the attestation's creation date: this is the historical timespan\n        being asserted, not when the assertion was made. It is no wider than\n        the source can witness: a source that shows a name in use only in its\n        own day (a letter, a survey, a gazetteer consulted now) supports a\n        timespan of that day, so the attested timespan then coincides with\n        the source's own date (plato:source_timespan), while remaining the\n        claim's.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "attests timespan"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#Timespan"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#geo_json",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        GeoJSON representation of the geometry. Used for web mapping\n        applications and LPF export. Should be a valid GeoJSON geometry\n        object (not a Feature or FeatureCollection). Its datatype is\n        rdf:JSON, the JSON literal of JSON-LD 1.1: the JSON-LD context\n        maps the geojson key with @type @json, which is the only way a\n        GeoJSON object in a document can become a literal rather than\n        a node, so every converted dataset already carries rdf:JSON.\n        (Before 0.7.0 the range was given as xsd:string, which no\n        conversion produced.)\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Geometry"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "geometry GeoJSON"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#contributor_role",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Role of the contributor in the project or gazetteer. Examples:\n        'principal_investigator', 'data_curator', 'student_researcher',\n        'automated_process', 'external_contributor'. Helps understand the\n        context and authority of contributions.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Contributor"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "contributor role"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#bbox",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Bounding box as array: [min_lon, min_lat, max_lon, max_lat].\n        Enables fast spatial filtering. Format: comma-separated string\n        or JSON array depending on serialization context.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Geometry"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "bounding box"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#SettingOf",
    "@type": [
      "https://w3id.org/plato#RelationType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The target event (a battle, a council, a fair) took place at the subject, wholly or in part."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "setting of"
      }
    ],
    "https://w3id.org/plato#inverse_label": [
      {
        "@value": "took_place_at"
      }
    ],
    "https://w3id.org/plato#relation_domain": [
      {
        "@value": "SpatialEntity"
      }
    ],
    "https://w3id.org/plato#relation_label": [
      {
        "@value": "setting_of"
      }
    ],
    "https://w3id.org/plato#relation_range": [
      {
        "@value": "event"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Authority",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Abstract superclass for all reference entities that provide provenance\n        or semantic grounding for attestations. Subtypes include Source,\n        Dataset, Period, RelationType, and CertaintyLevel.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Authority"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointUnionOf": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/plato#Source"
          },
          {
            "@id": "https://w3id.org/plato#Dataset"
          },
          {
            "@id": "https://w3id.org/plato#Period"
          },
          {
            "@id": "https://w3id.org/plato#RelationType"
          },
          {
            "@id": "https://w3id.org/plato#CertaintyLevel"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#form_status",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The status of the name form this attestation contributes: read in the\n        cited source, chosen by the cited authority, or derived by the\n        contributing project. Should point to a concept in a SKOS concept\n        scheme. The starter concepts are:\n\n        - plato:Attested: a form read in the cited source. The default, and\n          usually omitted.\n        - plato:Headword: the editorial or preferred form under which the\n          cited authority files the entry ('Bunsty Hundred'). A scholarly\n          decision rather than a reading, and typically the form users search\n          for. Another authority may choose differently, which is why it is a\n          sourced attestation and not a label on the SpatialEntity.\n        - plato:Normalised: a form derived from an attested one for matching\n          or search ('Bunstow(e)' resolved to 'Bunstowe'), attested by no\n          source and carrying no independent evidential value. It may point\n          to the attestation it was derived from through a meta-attestation.\n        - plato:Reconstructed: a form inferred but not attested, the\n          philologists' asterisked form.\n        - plato:Preferred: the form the contributing project prefers for\n          display and search ('Ranny (Fort)'). A project decision, so the cited\n          source may show a different form.\n        - plato:Editorial: a form written by the editors of the cited\n          edition in their own words, in its commentary, apparatus or notes,\n          and not in the text they edit. Without it, a name converted from\n          an editor's note would read as the source's own: Attested is the\n          default. Unlike a Headword, it is not the form an entry is filed\n          under but a mention, and it says nothing about whether the name is\n          attested elsewhere.\n\n        A different axis from plato:name_type, which classifies what the name\n        denotes: a headword is still a toponym. It sits on the Attestation,\n        not on the Name, because the same string can be a reading in one\n        attestation and a headword in another. The WHG ingestion prototype\n        reached the same placement independently: its preferred-name flag is\n        on the attestation, not on the toponym record.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "form status"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2004/02/skos/core#Concept"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Name",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        A toponym or appellation for a SpatialEntity. Names are independent, reusable\n        entities. The association between a Name and a SpatialEntity is always mediated\n        by an Attestation, which provides temporal scope and provenance.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Name"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#candidate_candidate",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Candidate"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "candidate entity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#SpatialEntity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#ContainedIn",
    "@type": [
      "https://w3id.org/plato#RelationType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The subject SpatialEntity is contained in the target SpatialEntity, for\n        the attested timespan: a parish in a hundred, a hundred in a county.\n        Not an identity relation and not fixed by the class model; it is a\n        claim, with a source and a certainty, like any other attestation.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "contained in"
      }
    ],
    "https://w3id.org/plato#authority_uri": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "http://vocab.getty.edu/ontology#broaderPartitive"
      }
    ],
    "https://w3id.org/plato#inverse_label": [
      {
        "@value": "contains"
      }
    ],
    "https://w3id.org/plato#relation_domain": [
      {
        "@value": "SpatialEntity"
      }
    ],
    "https://w3id.org/plato#relation_label": [
      {
        "@value": "contained_in"
      }
    ],
    "https://w3id.org/plato#relation_range": [
      {
        "@value": "SpatialEntity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#publisher",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Dataset"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "publisher"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#spatial_coverage",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Geographic or cultural region to which this period applies.\n        Free text or URI to a place/region. Useful because periods like\n        'Medieval' have different temporal bounds in different regions.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Period"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "spatial coverage"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#negated",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        True when the source states that what this attestation bundles is not\n        so: that a place had no market, that a name was not used, that a grant\n        was refused. The attestation is still about a real SpatialEntity (the\n        town that had no market), with the facet the source denies (a Type\n        'market'); nothing that never existed need be invented. A denial is a\n        statement a source makes, often a certain one, so it is neither low\n        certainty nor a meta-attestation, which needs a claim to contradict.\n        The 1886 return of market rights answered for every borough and\n        district in England and Wales, and 1,000 of its 1,813 rows are denials.\n\n        A consumer that does not implement this property will read a denial\n        as an assertion, the opposite of what the source says. So it must be\n        honoured: a tool that cannot express a denial in its target format\n        must leave the attestation out and report it, never write it as an\n        assertion. Bundle one denied facet per attestation, so that what is\n        denied is never in doubt. Absent or false, the attestation asserts.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "negated"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#TranscriptionAccuracyScheme",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Starter concepts for plato:transcription_accuracy. How faithfully a transcribed value renders what the source shows."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "transcription accuracy"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#has_timespan",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Links a Period authority to its temporal extent, represented as a\n        Timespan node. Used for locally-defined periods or when more detailed\n        temporal modeling is needed than provided by external period definitions.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Period"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has timespan"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#Timespan"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#PropertyValue",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        A quantitative or descriptive attribute of a SpatialEntity, expressed as a\n        property drawn from an external vocabulary together with its value.\n        Covers the many things a historical source says that are neither a\n        name, a location, a period nor a classification — populations,\n        valuations, elevations, recurrence rules for markets and fairs.\n\n        The property itself is identified by URI rather than enumerated here,\n        so the vocabulary stays open and delegated (Wikidata properties,\n        CIDOC-CRM, project vocabularies), in the same way that Type delegates\n        its classifications to AAT.\n\n        Values may be literals (with a datatype and optional unit) or\n        structured objects whose shape is declared by plato:value_type. As a\n        facet node, a PropertyValue may carry the qualification properties\n        (certainty, fuzziness) like any other.\n\n        Where the value is another SpatialEntity, use an entity-to-entity\n        relation instead; this class is for attributes of the entity. A person\n        or organisation connected to it (the grantee of a market right, an\n        owner, a lord of the manor) is such an attribute: the value is the\n        agent's IRI, ideally in an authority such as Wikidata or VIAF, with\n        value_datatype xsd:anyURI, and the property names the role, for\n        example http://www.wikidata.org/prop/direct/P127 ('owned by'). This\n        asserts nothing false, and needs no agent class: PLATO's own agent\n        classes (Contributor, Organization) describe who recorded the data.\n\n        A figure from a statistical table (a census count, a toll receipt) is\n        a PropertyValue that is also a qb:Observation of the W3C RDF Data\n        Cube vocabulary. It carries qb:dataSet (the table, a qb:DataSet), one\n        direct statement for each of its coordinates with the table's\n        qb:DimensionProperty predicates, one for each fact about the figure\n        with qb:AttributeProperty predicates (sdmx-attribute:obsStatus for a\n        cell's state), and plato:universe for the figure it is a part or share\n        of. So the county is not said to have 'class 1': the observation is.\n        The measure stays plato:property_type and plato:value_literal, and the\n        area and date stay on the attestation; a cube export adds the direct\n        measure statement, sdmx-dimension:refArea and refPeriod. A printed dash\n        is an observation with an obsStatus and no value, never 0. Money is\n        an exact integer in the smallest unit of its system of account\n        (farthings, for sterling amounts with halfpennies), the unit an IRI\n        from a fitting authority or minted by the encoding project, ideally\n        naming a unit of account in a named system ('penny sterling'); PLATO\n        mints no currency and converts nothing. A coordinate the source does\n        not give is an explicit 'unknown' code. A table mixing measures is one\n        qb:DataSet per measure. Dimension values are concepts, with the\n        source's label as skos:prefLabel, in code lists the encoding project\n        publishes where none exists. A statistical table in spreadsheet form\n        keeps its own CSV on the Web description and links to places by\n        place_id. The design, and its testing on three corpora, is issue #14.\n\n        A latitude given without a longitude (a source's 'at 9.5 degrees\n        north') is a PropertyValue, not a Geometry, since it is not a location:\n        property http://www.w3.org/2003/01/geo/wgs84_pos#lat, the value in\n        decimal degrees. A longitude alone is the same, with wgs84_pos#long.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Property Value"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#meta_attestation_about",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Links a meta-Attestation to the Attestation it comments on or relates to.\n        Used with plato:has_meta_type to specify the nature of the relationship.\n        A meta-attestation need not carry plato:attests_about: it is about its\n        target, and through it about the target's SpatialEntity. Where it does\n        carry one (as when nested under a place in place-centric JSON), that\n        should be the target's.\n\n        Example: A meta-attestation might assert that one source's geometry\n        attestation contradicts another source's geometry attestation for the\n        same SpatialEntity.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "meta-attestation about"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#language",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        BCP 47 language tag for this name (e.g., 'ar' for Arabic, 'zh-Hans'\n        for Simplified Chinese). Recommended: use ISO 639-3 three-letter codes\n        within BCP 47 for better granularity (e.g., 'ara', 'cmn').\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Name"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "language"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#contains_entity",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Links a Gazetteer to a SpatialEntity it defines. A SpatialEntity defined elsewhere that this Gazetteer only attests evidence about is not contained in it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Gazetteer"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "contains entity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#SpatialEntity"
      }
    ]
  },
  {
    "@id": "https://orcid.org/0000-0003-3060-0181",
    "@type": [
      "http://xmlns.com/foaf/0.1/Person"
    ],
    "http://xmlns.com/foaf/0.1/account": [
      {
        "@id": "https://github.com/docuracy"
      }
    ],
    "http://xmlns.com/foaf/0.1/mbox": [
      {
        "@id": "mailto:stephen.gadd@pitt.edu"
      }
    ],
    "http://xmlns.com/foaf/0.1/name": [
      {
        "@value": "Stephen Gadd"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#MetaTypeScheme",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Starter concepts for plato:has_meta_type. The nature of a meta-attestation's relationship to its target attestation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "meta-attestation type"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#relates_to",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Links an Attestation to the second entity of a relationship between\n        the Attestation's subject entity (via attests_about) and this target.\n        The semantic nature of the relationship is specified by\n        plato:has_relation_type, which references a RelationType authority.\n\n        Example: An attestation about Constantinople that relates_to the\n        Byzantine Empire with relation_type \"capital_of\" asserts that\n        \"Constantinople was the capital of the Byzantine Empire\".\n\n        The target is usually another SpatialEntity in the same dataset. It\n        may instead be an entity that is not spatial and is described\n        elsewhere: a person, an object or an event, identified by its IRI\n        (an attestation about Lumbini that relates_to the Buddha, with\n        plato:BirthplaceOf). There is deliberately no rdfs:range, so such a\n        target is not inferred to be a SpatialEntity. Give an external target\n        a plato:related_label. Platforms should show relations to entities\n        that are not spatial apart from spatial ones, and leave them out of\n        containment, clustering and matching.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "relates to"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#RelationType",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        A vocabulary entry defining a semantic relationship between SpatialEntities:\n        'capital_of', 'successor_to', 'connected_by_trade_route_to', etc.\n        Carries a label, an inverse label, and domain/range constraints.\n        This allows the vocabulary of historical relationships to grow\n        without modifying the core ontology.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Relation Type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/plato#Authority"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#SpatialEntity",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        An entity whose identity is bound up with space, whether its spatial\n        extent is attested directly, applies notionally (as with the region to\n        which a period applies), or is derived from its constituents (as with a\n        route or a network, whose extent is that of its members). A\n        SpatialEntity need not have any attested geometry: lost, imagined and\n        unlocated entities are admissible.\n\n        A curated selection of other places, such as a thematic collection, is\n        not a SpatialEntity: it is a Gazetteer, whose attestations are about\n        the places it selects.\n\n        What kind of entity it is (settlement, route, region, administrative\n        unit and so on) is not fixed by the class. It is established by\n        Type attestations, so a classification is a claim rather than an axiom.\n\n        SpatialEntities are not defined by any single attestation. They are the\n        point of convergence for many attestations from different sources,\n        periods and contributors.\n\n        PLATO defines no Place class and gives \"place\" no prescribed\n        meaning. Many SpatialEntities are what people would call places and\n        some are not, and the word is used differently across languages and\n        disciplines. The ontology therefore neither equates a SpatialEntity\n        with a place nor defines a place in terms of SpatialEntities or\n        their attestations. Where the word appears in this document it is\n        used in its ordinary sense.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Spatial Entity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#DerivedFrom",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "This attestation's value was derived from the target attestation's, as a normalised search form is derived from an attested spelling."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#MetaTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "derived from"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#bibliographic_string",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        A formatted citation string for this source or other authority. The\n        domain is Authority, not Source, because any authority can be cited\n        formally, a dataset as much as a document. Restricting it to Source\n        made a cited Dataset a Source as well, which the disjoint union of\n        Authority forbids.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Authority"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "bibliographic string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Preferred",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The form the contributing project prefers for display and search: a project decision, so the cited source may show a different form."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#FormStatusScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "preferred"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#romanized",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Romanized (Latin-script) form of the name for searchability and\n        display in contexts requiring ASCII. Should specify transliteration\n        system used via plato:transliteration_system.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Name"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "romanized"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#similarity_score",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The matching algorithm's score for this candidate, on the scale\n        that algorithm uses (named by algorithm_version): higher is more\n        similar. It is not a certainty, since a Candidate asserts nothing.\n\n        Any XSD numeric datatype is accepted (xsd:decimal, xsd:double,\n        xsd:float, xsd:integer and the others), so it has no rdfs:range.\n        PLATO tools writes a whole number as xsd:integer and any other as\n        xsd:double, as JSON-LD does.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Candidate"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "similarity score"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#contributor_affiliation_string",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Free-text organizational affiliation when a structured Organization\n        entity is not available. Example: \"University of Pittsburgh,\n        Institute for Spatial History Innovation\"\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Contributor"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "affiliation (string)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#precision_value",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Numeric precision indicator in years. For example, a decade-level\n        precision would have value 10, century-level would be 100. Enables\n        computational comparison of precision across timespans.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Timespan"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "precision value"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#start_precision",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Temporal granularity of the start bound. Values: 'day', 'month',\n        'year', 'decade', 'century', 'era', 'geological_period' (as the\n        JSON Schema's precision enumeration). This describes the resolution\n        of the date specification, distinct from certainty (which describes\n        the confidence in that specification).\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Timespan"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "start precision"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#StanceDoubted",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The source raises it and declines to settle it. Not a denial, which is plato:negated."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#SourceStanceScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "doubted"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#computed",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        True when this value, or this whole attestation, was worked out by\n        software from other data rather than taken from a source: an\n        itinerary's timespan from the timespans of its stops, a route's\n        geometry from its stations. A computed value is not evidence. A\n        consumer may show it, but must not take it in as an attestation of\n        its own: it should compute the value again from the members, or leave\n        it out and say so. Absent or false, a value is attested.\n\n        It is for a value derived from other statements in the same data,\n        which any consumer holding them could derive again. A figure a\n        project works out from its own source material and publishes as a\n        finding (letters counted from a register, a median taken over them)\n        is not computed in this sense: it is attested, citing the work that\n        produced it as a Source or Dataset derived_from the material it was\n        worked out from. Nor is a geometry traced from a map and placed\n        through a georeference: software fits the transformation, but the\n        geometry is evidence of what the map shows (see plato:Geometry).\n\n        It is not plato:form_status Normalised (a name form an editor\n        derived from an attested one), nor a Candidate (a match an algorithm\n        suggests). Like the qualification properties it has no rdfs:domain,\n        so it can mark an Attestation or any facet node.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "computed"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Contributor",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        A person, team, or automated process that creates attestations.\n        Aligned with both foaf:Agent and prov:Agent for provenance\n        chain-of-custody tracking.\n\n        Contributors should be identified using persistent identifiers where\n        possible. For persons, ORCID (https://orcid.org/) is strongly\n        recommended and may be required by specific implementations. ORCID\n        identifiers should use the full URI format (https://orcid.org/0000-0000-0000-0000)\n        rather than just the numeric portion, as ORCID is particular about\n        proper URI formatting for linked data interoperability.\n\n        For organizations, ROR (https://ror.org/) or ISNI identifiers are\n        recommended. Proper identification ensures accurate attribution,\n        enables citation, and supports research assessment.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Contributor"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://xmlns.com/foaf/0.1/Agent"
      },
      {
        "@id": "http://www.w3.org/ns/prov#Agent"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#namespace",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Whose identifier plato:entity_identifier is (e.g. 'geonames', 'wikidata',\n        'tgn', 'osm', 'pleiades', 'whg', or the contributing project's own short\n        name). Authority-sourced SpatialEntities carry their origin namespace;\n        contributed SpatialEntities that cannot be linked to any authority\n        receive the 'whg' namespace.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#SpatialEntity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "namespace"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Period",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        A named historical period (e.g. 'Byzantine', 'Early Modern'),\n        optionally linked to PeriodO or defined locally. Includes temporal\n        bounds for period-based querying.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Period"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/plato#Authority"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/bibliographicCitation": [
      {
        "@value": "Gadd, Stephen, and the Pelagios Network Place Working Group. PLATO — Place Attestation Ontology, version 0.8.0. Zenodo, 2026. https://doi.org/10.5281/zenodo.21688313"
      }
    ],
    "http://purl.org/dc/terms/contributor": [
      {
        "@value": "Pelagios Network Place Working Group"
      }
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-02-16"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@id": "https://orcid.org/0000-0003-3060-0181"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "\n        An ontology for representing historical place knowledge as attestations:\n        bundles of evidence linking SpatialEntities (settlements, routes,\n        networks, administrative units, regions and other entities whose\n        identity is bound up with space) to Names, Geometries, Timespans,\n        Types, PropertyValues and Authorities with full provenance.\n\n        Developed by the Pelagios Network's Place Working Group, led by the\n        Institute for Spatial History Innovation (ISHI), University of Pittsburgh.\n\n        PLATO formalises the WHG v4 data model, in which the Attestation is\n        the fundamental unit of contributed knowledge. The Linked Places\n        Format (LPF) is defined as its single-object-attestation profile:\n        every LPF element corresponds to one attestation linking one entity\n        to one name, type, geometry or related entity, so existing LPF files\n        remain valid. The use cases of Linked Traces are accommodated within\n        the same model.\n    "
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-10-01"
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "en",
        "@value": "PLATO — Place Attestation Ontology"
      }
    ],
    "http://purl.org/ontology/bibo/doi": [
      {
        "@value": "10.5281/zenodo.21688313"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespacePrefix": [
      {
        "@value": "plato"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespaceUri": [
      {
        "@value": "https://w3id.org/plato#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://pelagios.org/place-attestation-ontology/index-en.html"
      }
    ],
    "http://www.w3.org/2002/07/owl#priorVersion": [
      {
        "@id": "https://w3id.org/plato/0.7.1"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionIRI": [
      {
        "@id": "https://w3id.org/plato/0.8.0"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "0.8.0"
      }
    ],
    "http://www.w3.org/ns/dcat#keyword": [
      {
        "@language": "en",
        "@value": "ontology"
      },
      {
        "@language": "en",
        "@value": "historical gazetteer"
      },
      {
        "@language": "en",
        "@value": "place"
      },
      {
        "@language": "en",
        "@value": "attestation"
      },
      {
        "@language": "en",
        "@value": "provenance"
      },
      {
        "@language": "en",
        "@value": "linked open data"
      },
      {
        "@language": "en",
        "@value": "digital humanities"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#declares_relation_type",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Links a Gazetteer to a RelationType it declares for its own use: a\n        project's 'flows into', with its label, inverse label and the starter\n        type it narrows (plato:broader_relation). The JSON profiles carry\n        these in a document-level relationTypes array, beside dataSets. A\n        relation type PLATO declares needs no declaration here.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Gazetteer"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "declares relation type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#RelationType"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#type_label",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Human-readable label for this type."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "type label"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#modified",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Timestamp when this attestation was last modified, while its\n        Gazetteer is still a draft. Once the Gazetteer is published its\n        attestations are append-only (see plato:Gazetteer): a published\n        attestation is not modified, and a change is a new attestation with a\n        meta-attestation, so that the state at any earlier moment can be\n        recomputed and every citation of it reproduces.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "modified"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTime"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#UpstreamOf",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Upstream of the anchor along a watercourse."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#RelativeQualifierScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "upstream of"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#entity_identifier",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        An identifier for this SpatialEntity other than its IRI: the\n        contributing project's own record id ('GLOB_366') or an authority's\n        ('geonames:2654675'), with plato:namespace saying whose. A finding aid,\n        like a label: not a claim about the place.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#SpatialEntity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "identifier"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#name_embedding",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Vector embedding for phonetic similarity search: a vector generated\n        from the name's phonetic form, enabling fuzzy matching and\n        transliteration-variant detection. Its model and dimension are the\n        producer's (WHG v4 uses Symphonym embeddings), so both must be\n        stated in the gazetteer's description: vectors from different\n        models cannot be compared.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Name"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "name embedding"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#attests_geometry",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Links an Attestation to a Geometry it asserts for the SpatialEntity. An\n        attestation may assert multiple geometries (e.g., point and polygon)\n        or no geometry at all (e.g., name-only attestations from textual sources).\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "attests geometry"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#Geometry"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#end_precision",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Temporal granularity of the end bound. Values: 'day', 'month',\n        'year', 'decade', 'century', 'era', 'geological_period'.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Timespan"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "end precision"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#identity_subject",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The first SpatialEntity in an identity assertion."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#IdentityRelation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "identity subject"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#SpatialEntity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Dataset",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        A collection-level authority: a published gazetteer, a contributed\n        dataset, or an external authority corpus (GeoNames, Wikidata, TGN,\n        OSM, Pleiades). Carries metadata such as title, version, publisher,\n        and URI, and a licence (dcterms:license, as for any Authority).\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Dataset"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/plato#Authority"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#contributor_affiliation",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Organizational affiliation of the contributor. Links to a\n        plato:Organization entity, which can be further described using\n        FOAF, schema.org, or other ontology properties. Organizations\n        should ideally use persistent identifiers (ROR, ISNI, etc.).\n\n        For simple cases, use contributor_affiliation_string for free-text\n        affiliation names.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Contributor"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "affiliation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#Organization"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#identity_type",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The semantic strength of the identity assertion:\n        'exactMatch'  — the two SpatialEntities are unambiguously the same entity.\n        'closeMatch'  — the two SpatialEntities are believed to be the same entity\n                        but with some residual ambiguity (e.g. differing\n                        granularity, overlapping but not identical scope).\n        'related'     — the two SpatialEntities are closely associated but may not\n                        be strictly identical (e.g. a settlement and its\n                        administrative district, or successive phases of\n                        a site that might or might not constitute continuity).\n        'unspecified' — the source links the two but does not say how strongly;\n                        honest where the alternative is to guess a strength.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#IdentityRelation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "identity type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#AttributionInferred",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The source was given as ibidem or idem and resolved by an editor, so the attribution is inferred rather than stated."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#AttributionStatusScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "attribution inferred"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#contributor_name",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The name of the contributor (person, team, or automated process).\n        For persons, should be the full name as preferred by the contributor.\n        For teams, the team name. For automated processes, a descriptive name.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Contributor"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "contributor name"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#certainty",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Epistemic certainty, from 0.0 (completely uncertain) to 1.0\n        (completely certain). On an Attestation it is the contributor's\n        confidence in the bundle as a whole. On a facet node (Name, Geometry,\n        Timespan, Type, PropertyValue) it is the confidence in that value\n        alone, and may differ from the attestation's overall certainty.\n        Certainty reflects the limits of evidence: better evidence could in\n        principle raise it. Distinct from fuzziness (the referent has no\n        sharp boundary) and from spatial_precision (how finely a location\n        is specified). No rdfs:domain, so it can qualify any node.\n\n        It is never the source's own confidence: how firmly a source asserts\n        what it says (hedging, hearsay, doubt) is plato:source_stance.\n\n        Any XSD numeric datatype is accepted, from 0 to 1 (xsd:decimal, xsd:double,\n        xsd:float, xsd:integer and the others), so it has no rdfs:range.\n        PLATO tools writes a whole number as xsd:integer and any other as\n        xsd:double, as JSON-LD does.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "certainty"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#name_type",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        What the name denotes. The list is open: 'toponym' (place name),\n        'chrononym' (period or era name), 'ethnonym' (people or ethnic\n        group), 'demonym' (inhabitants), 'odonym' (street or road name) and\n        'hydronym' (water body) are the starter values, and a project may\n        add others ('oronym', 'hagionym') provided it documents them in its\n        gazetteer metadata. Multiple types are possible (a name that\n        functions as both toponym and ethnonym). plato.schema.json carries\n        the same open list; earlier releases closed it there, and the two\n        serialisations now agree.\n\n        This classifies the referent, not the status of the form. Whether a\n        string is an attested spelling, an editorial headword or a derived\n        search form is a property of the attestation (plato:form_status),\n        because the same string can have a different status in different\n        attestations.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Name"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "name type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Organization",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        An organization to which a Contributor is affiliated. This is a\n        lightweight class defined primarily to avoid ambiguity in ontology\n        visualizations. Organizations can be further described using properties\n        from FOAF, schema.org, or other ontologies.\n\n        Organizations should use persistent identifiers where possible:\n        - ROR (Research Organization Registry): https://ror.org/\n        - ISNI (International Standard Name Identifier)\n        - Wikidata QIDs\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Organization"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#RepresentativePoint",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A proxy point standing in for the whole SpatialEntity, for indexing and display; it need not depict any feature of it."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#GeometryRoleScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "representative point"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#identity_asserted_by",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The agent who made or confirmed this identity assertion."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#IdentityRelation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "asserted by"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#Contributor"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#candidate_status",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The Candidate's status when its CandidateSet was issued: 'suggested'.\n        Fixed from then on, since a published Candidate is never changed. It is\n        not the outcome of a review, which is read from the attestations\n        pointing at the Candidate through plato:promoted_from (see\n        plato:Candidate).\n\n        Deprecated: the values 'confirmed' and 'rejected', kept in this comment\n        for one release so that existing data still reads, and removed in the\n        release after; the JSON Schema refuses them already. A producer that accepts matches automatically, with\n        no person reviewing them, should not publish them as 'confirmed'\n        Candidates: it should publish identity attestations (an Attestation\n        bundling IdentityRelations, attributed to the producer, each pointing\n        back through plato:promoted_from), which are claims, attributed and\n        withdrawable; a producer that rejects a match should leave it out of\n        the set, or publish a negated attestation if the rejection is a claim.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Candidate"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "status"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#GeometryRoleScheme",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Starter concepts for plato:geometry_role. What a geometry depicts, as distinct from how precisely it is known."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "geometry role"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#partOf",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Links a Source to its parent Dataset."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Source"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "part of"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#Dataset"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Normalised",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A form derived from an attested one for matching or search, attested by no source and carrying no independent evidential value."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#FormStatusScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "normalised"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#relative_bearing",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Compass bearing from the anchor, in degrees (0–360).\n        Primarily used for relative geometries: '90' means east of\n        the anchor. May carry its own certainty or fuzziness.\n\n        Any XSD numeric datatype is accepted, from 0 to 360 (xsd:decimal, xsd:double,\n        xsd:float, xsd:integer and the others), so it has no rdfs:range.\n        PLATO tools writes a whole number as xsd:integer and any other as\n        xsd:double, as JSON-LD does.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "bearing"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#scheme_version",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The version of the vocabulary (the skos:inScheme of this Type) that the\n        type was taken from: '2017' for the RESOLVE ecoregions, a release date\n        for OpenStreetMap's tag definitions. Needed where a scheme's terms\n        change meaning between versions; otherwise optional. JSON\n        schemeVersion, tables type_scheme_version, beside the scheme (JSON\n        scheme, tables type_scheme).\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "scheme version"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#contributor_identifier",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Additional persistent identifier for the contributor. Can be used\n        for identifiers other than ORCID, such as:\n        - ISNI (International Standard Name Identifier)\n        - VIAF (Virtual International Authority File)\n        - Wikidata QID (for persons or organizations)\n        - Internal system identifiers\n\n        When using this property, specify the identifier type in the value\n        (e.g., \"ISNI:0000000121032683\" or \"VIAF:12345678\").\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Contributor"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "contributor identifier"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#relative_distance",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Distance from the anchor, in metres. Primarily used for\n        relative geometries. May carry its own certainty or fuzziness.\n\n        Any XSD numeric datatype is accepted, zero or more (xsd:decimal, xsd:double,\n        xsd:float, xsd:integer and the others), so it has no rdfs:range.\n        PLATO tools writes a whole number as xsd:integer and any other as\n        xsd:double, as JSON-LD does.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "distance"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#attests_about",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Links an Attestation to the SpatialEntity it is about. Every attestation must\n        have exactly one subject entity. This is the primary entity being\n        described by the bundled name, geometry, timespan, and type assertions.\n\n        Functional property: each attestation has exactly one subject entity.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "attests about"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#SpatialEntity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Source",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        A citable source of evidence: a manuscript, chronicle, tax record,\n        map, scholarly article, or other document. Sources are the primary\n        provenance anchor for attestations. A Source may reference its parent\n        Dataset via plato:partOf.\n\n        A Source's licence, that of the edition or copy cited, is given with\n        dcterms:license, as a Gazetteer's is. A project that admits evidence\n        by its licence (citing a share-alike source as a witness but never\n        copying it, say) needs the licence on the thing cited, so that it\n        travels with the data.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Source"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/plato#Authority"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#citation_function",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Why the source is cited: as the evidence for the attestation, as a\n        source of its data, as related reading, and so on. The value is a\n        property of CiTO, the Citation Typing Ontology\n        (http://purl.org/spar/cito/): cito:citesAsEvidence,\n        cito:citesAsDataSource, cito:citesAsRelated, cito:citesForInformation,\n        cito:citesAsRecommendedReading, or another of the properties below\n        cito:cites. Only CiTO properties are used, so that every consumer reads\n        the same function the same way; a project whose own vocabulary has\n        other terms maps them to CiTO when it organises its data.\n\n        Without it, 'this source is the evidence' and 'see this source for\n        more' are the same link, which is the distinction an attestation model\n        exists to make: 143,418 of Pleiades' 244,759 references are 'see\n        further', and only 21,652 are cited as evidence. Absent, the function\n        is unstated, as before; a consumer should not assume evidence.\n\n        Only a property CiTO defines is a valid value. An IRI in the CiTO\n        namespace is not enough: Pleiades writes cito:seeFurther and\n        cito:seeAlso, which CiTO does not define, so the JSON Schema and the\n        tables list the accepted properties exactly.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Citation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "citation function"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#hull",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Convex hull of the geometry as WKT Polygon. Used for quick spatial\n        filtering before more expensive exact geometry operations. Optional\n        but recommended for complex geometries.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Geometry"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "convex hull"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.opengis.net/ont/geosparql#wktLiteral"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#geometry_role",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        What this geometry depicts, as distinct from how precisely it is known\n        (plato:spatial_precision) or where its indexing point falls\n        (plato:repr_point). A SpatialEntity may be attested with several geometries at\n        once — a built extent, the location of a specific central feature, a\n        proxy standing in for the whole, the anchor of a map label — and without\n        a declared role a consumer cannot tell them apart, nor state which one\n        an analysis used.\n\n        Should point to a concept in a SKOS concept scheme (e.g. plato:Extent,\n        plato:FeaturePoint, plato:RepresentativePoint, plato:LabelAnchor,\n        plato:Itinerary). Using URIs rather than free text lets gazetteers that\n        record geometry differently be compared.\n\n        Note that role is orthogonal to precision: a proxy locator may be\n        surveyed to the metre and still not depict the SpatialEntity it stands for. A\n        parish church's coordinates contributed as a locator for a town are a\n        representative point of high precision, not an imprecise feature point.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Geometry"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "geometry role"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2004/02/skos/core#Concept"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Near",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Close to the anchor, without a stated bearing or distance."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#RelativeQualifierScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "near"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#contributed_by",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The agent (person, team, or process) who created this attestation.\n\n        Semantically equivalent to PROV-O's prov:wasAttributedTo for provenance\n        tracking. We don't use formal rdfs:subPropertyOf to avoid importing\n        PROV-O's domain/range constraints. Distinct from sourced_by, which\n        indicates the historical source being cited.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "contributed by"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#Contributor"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#contains_attestation",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Links a Gazetteer to an Attestation contributed within it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Gazetteer"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "contains attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Certain",
    "@type": [
      "https://w3id.org/plato#CertaintyLevel"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The statement is certain: the source, or the contributor, has no doubt of it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "certain"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#fuzziness",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Ontological fuzziness: a measure of how inherently vague or\n        indeterminate the facet's referent is, from 0.0 (crisp, sharply\n        bounded) to 1.0 (maximally vague). Distinct from certainty:\n        fuzziness is a property of the thing itself, not of our knowledge\n        of it. A regional boundary that was never precisely defined has\n        high fuzziness regardless of how much evidence we have.\n\n        Any XSD numeric datatype is accepted, from 0 to 1 (xsd:decimal, xsd:double,\n        xsd:float, xsd:integer and the others), so it has no rdfs:range.\n        PLATO tools writes a whole number as xsd:integer and any other as\n        xsd:double, as JSON-LD does.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "fuzziness"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#TranscriptionAccurate",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The transcription renders what the source shows."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#TranscriptionAccuracyScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "accurate"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#geo_wkt",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Well-Known Text representation of the geometry, following OGC/ISO\n        standards. Used for GeoSPARQL queries and RDF serialization.\n        Supports Point, LineString, Polygon, MultiPoint, MultiLineString,\n        MultiPolygon.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Geometry"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "geometry WKT"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.opengis.net/ont/geosparql#wktLiteral"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "http://www.opengis.net/ont/geosparql#asWKT"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#has_meta_type",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The nature of a meta-attestation's relationship to its target attestation.\n        Should reference a controlled vocabulary concept defining the relationship\n        type. The starter concepts, declared in this ontology's MetaTypeScheme:\n\n        - plato:Contradicts: asserts the target attestation is incorrect\n        - plato:Supports: provides additional evidence for the target attestation\n        - plato:Supersedes: replaces the target attestation with newer information\n        - plato:Refines: provides more precise information than the target\n        - plato:Challenges: questions the target attestation's validity\n        - plato:Bundles: groups the target with other related attestations\n        - plato:DerivedFrom: this attestation's value was derived from the\n          target's (a normalised search form from an attested spelling)\n        - plato:Annotates: adds a remark about the target, with its own source,\n          without supporting, contradicting or refining it; the remark is the\n          meta-attestation's notes\n        - plato:AlternativeTo: this attestation and the target are alternative\n          readings of the same evidence, at most one of them right\n        - plato:Retracts: the target attestation is withdrawn by whoever made\n          it, and kept only so that earlier states can be reproduced\n\n        Using SKOS concepts rather than strings enables vocabulary management\n        and multilingual labels.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "meta-attestation type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2004/02/skos/core#Concept"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#value_literal",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The value, where it is a literal: a number, a string, a date. Use\n        plato:value_json instead where the value is structured.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#PropertyValue"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "value"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Literal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#attribution_status",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Whether the attribution of the evidence to the cited source was\n        stated by the source or resolved editorially. Should point to a\n        concept in a SKOS concept scheme. The starter concepts are:\n\n        - plato:AttributionStated: the source is named where the form\n          occurs. The default, and usually omitted.\n        - plato:AttributionInferred: the source was given as 'ibidem' or\n          'idem' and resolved by an editor, so the attribution is inferred\n          rather than stated. Not marginal: about one attestation in twenty\n          in the English Place-Name Society corpus.\n\n        A statement about the citation, not about the form, which is why it\n        lives here and not in plato:occurrence_context.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Citation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "attribution status"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2004/02/skos/core#Concept"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#universe",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The figure this figure is a part or share of: its denominator, where\n        the source defines one. Asserted only from the source, never inferred\n        from labels or sums: in Vision of Ireland three of seven plausible\n        denominators by name are wrong. The occupied beside the\n        total of the same row, or Vision of Ireland's Total Population cube as\n        the universe of the others for the same unit and year. RDF Data Cube\n        has no such property, and without it which number is the denominator\n        of which is lost, unrecoverably once the table is gone.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#PropertyValue"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "universe"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#PropertyValue"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#broader_relation",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The more general RelationType of which this one is a narrower case:\n        a project's 'flows into' has broader_relation plato:LeadsTo, so any\n        attestation of the one is also, for a consumer that follows this\n        link, an attestation of the other. A narrower type keeps the\n        direction of its broader one. Transitive in use: a consumer should\n        follow the chain to the starter type it knows.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#RelationType"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "broader relation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#RelationType"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#GazetteerGroup",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        A thematic or organisational grouping of Gazetteers (e.g.\n        'EMEW — Gazetteer of Early Modern England and Wales').\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Gazetteer Group"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#member_of_group",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Links a Gazetteer to a GazetteerGroup."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Gazetteer"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "member of group"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#GazetteerGroup"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#certainty_level",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Certainty as a word rather than a number: a CertaintyLevel, such as\n        plato:Certain, plato:LessCertain or plato:Uncertain (the three of Linked\n        Places Format), or one a project declares. Use it when certainty is\n        stated in words, by a dataset or on a project's own scale, rather than\n        inventing a number for plato:certainty; the two may also be given\n        together. It is the same confidence as plato:certainty, the\n        contributor's or editor's, not the source's: a source that hedges or\n        reports is recorded with plato:source_stance. Like\n        plato:certainty it has no rdfs:domain, so it can qualify an Attestation\n        or any facet node.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "certainty level"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#CertaintyLevel"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#has_relation_type",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Specifies the semantic type of a entity-to-entity relationship\n        attested by an Attestation. References a RelationType authority\n        which defines the relationship's label, inverse, and domain/range\n        constraints. Examples: 'capital_of', 'successor_to',\n        'connected_by_trade_route_to'.\n\n        The extensible vocabulary pattern allows new relationship types to\n        be added as Authority records without modifying the ontology.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has relation type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#RelationType"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#repr_point",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        A single representative point (centroid, label point, or best\n        estimate) for spatial indexing and distance queries. Stored as WKT\n        Point. Required for all geometries to enable spatial search.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Geometry"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "representative point"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.opengis.net/ont/geosparql#wktLiteral"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#source_timespan",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        When this Source, as a document, was produced: the date of the\n        manuscript, the compilation of the cartulary, the publication of the\n        edition. Distinct from the Timespan an attestation asserts, which\n        dates the claim rather than the witness. An annal for 921 read in a\n        manuscript written c. 925 has an attested timespan of 921 and a\n        source timespan of c. 925. Reuses Timespan, so an approximate date\n        is start_earliest 915, end_latest 935, timespan_label 'c. 925'. The\n        same move as plato:has_timespan on a Period.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Source"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "source timespan"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#Timespan"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#identity_basis",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Free-text explanation of the evidence or reasoning supporting\n        this identity assertion (e.g. 'coordinates within 500m and\n        name forms are cognate', 'identified by contributor during\n        reconciliation review', 'confirmed via TGN cross-reference').\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#IdentityRelation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "identity basis"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#candidates_for",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Links a CandidateSet to the Gazetteer whose SpatialEntities matches\n        were sought for: the dataset its Candidates' sources normally belong\n        to, and whose identity relations answer them. A dataset may name its\n        candidate sets from its own side (in JSON, the gazetteer's\n        candidateSets, which maps to the reverse of this property); no\n        inverse property is defined, and both ends should agree.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#CandidateSet"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "candidates for"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#Gazetteer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#relative_to",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Links a facet node to its anchor entity, indicating that this\n        facet is defined relationally rather than absolutely. The anchor\n        is typically a SpatialEntity, Period, or another facet (Name, Timespan, etc.).\n\n        Common patterns:\n        - Spatial relativity: \"20km east of Nanjing\" (anchor is a SpatialEntity)\n        - Temporal relativity: \"during the reign of Justinian\" (anchor is a Period)\n        - Name relativity: \"also known as Rome\" (anchor is another Name)\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "_:ne8cfdc39ccf14eb98b3581d86d7bdceab8"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "relative to"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "_:ne8cfdc39ccf14eb98b3581d86d7bdceab13"
      }
    ]
  },
  {
    "@id": "_:ne8cfdc39ccf14eb98b3581d86d7bdceab8",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2002/07/owl#unionOf": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/plato#Name"
          },
          {
            "@id": "https://w3id.org/plato#Geometry"
          },
          {
            "@id": "https://w3id.org/plato#Timespan"
          },
          {
            "@id": "https://w3id.org/plato#Type"
          }
        ]
      }
    ]
  },
  {
    "@id": "_:ne8cfdc39ccf14eb98b3581d86d7bdceab13",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2002/07/owl#unionOf": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/plato#SpatialEntity"
          },
          {
            "@id": "https://w3id.org/plato#Name"
          },
          {
            "@id": "https://w3id.org/plato#Timespan"
          },
          {
            "@id": "https://w3id.org/plato#Type"
          },
          {
            "@id": "https://w3id.org/plato#Period"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#EntityKindScheme",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Starter concepts for the kinds of SpatialEntity a platform treats specially: routes, itineraries, networks and segments. A Type attestation names one in its type identifier."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "kind of spatial entity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#WorkplaceOf",
    "@type": [
      "https://w3id.org/plato#RelationType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The target person or group worked, or held office, at the subject, for the attested timespan: Linked Traces' heldOffice, and work generally."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "workplace of"
      }
    ],
    "https://w3id.org/plato#inverse_label": [
      {
        "@value": "worked_at"
      }
    ],
    "https://w3id.org/plato#relation_domain": [
      {
        "@value": "SpatialEntity"
      }
    ],
    "https://w3id.org/plato#relation_label": [
      {
        "@value": "workplace_of"
      }
    ],
    "https://w3id.org/plato#relation_range": [
      {
        "@value": "person or group"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Gazetteer",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        A mutable, versioned workspace of SpatialEntities and Attestations,\n        owned by a contributor or team. Replaces the WHG v3\n        concepts of Dataset, Dataset Collection, and Place Collection.\n        A Gazetteer can be incrementally edited, enriched, and corrected\n        without re-ingestion.\n\n        A Gazetteer's attestations need not be about SpatialEntities it\n        defines. It may attest evidence about SpatialEntities defined in other\n        Gazetteers, identified by their IRIs, without redefining them: a\n        correction to another project's place, a link from a record to an\n        existing place, a curator's selection of places for a collection.\n        Such an attestation adds evidence. It does not change the entity's\n        identity or make this Gazetteer its owner, and its source, contributor\n        and status are this Gazetteer's. The append-only rule of a published\n        Gazetteer applies to the attestations it contains, not to everything\n        said elsewhere about its entities. In PLATO JSON such attestations go\n        in an attestation-centric document, whose 'about' gives the entity's\n        IRI; a place-centric document declares every SpatialEntity it lists\n        (plato:contains_entity), so it lists only its own.\n\n        As a dcat:Dataset, a Gazetteer is titled with dcterms:title and\n        licensed with dcterms:license. Not with plato:authority_title or\n        plato:licence: their domains are plato:Authority and plato:Dataset,\n        so using them would make the Gazetteer one of the Authorities it\n        contains attestations about.\n\n        Described for discovery and citation (the FAIR principles), again in\n        the vocabularies a catalogue already reads: dcterms:creator for the\n        people to cite (plato:gazetteer_owner, its owner, is not necessarily\n        an author); dcat:keyword; dcterms:spatial for the area it covers, as\n        an address; dcterms:temporal for the years it covers, a\n        dcterms:PeriodOfTime with dcat:startDate and dcat:endDate;\n        dcat:landingPage; and void:uriSpace, the base from which its entities'\n        IRIs are made. A published Gazetteer (plato:gazetteer_status\n        'published') must state its dcterms:license: data others are to reuse\n        needs its terms stated. All the other descriptive properties are\n        optional.\n\n        Versions, and so citations that reproduce. A SpatialEntity's evidence\n        grows and is corrected while its identity stays the same, so a\n        citation of it must say which state was meant. For the same reason\n        as above, a Gazetteer's version uses DCAT 3's own properties, not a\n        PLATO one: dcat:version for its version indicator, and, for a frozen\n        snapshot published under its own IRI, dcat:isVersionOf (the living\n        Gazetteer) and dcat:previousVersion (the snapshot before). A\n        SpatialEntity is then cited as its IRI plus the Gazetteer version,\n        one number per gazetteer rather than one per entity, as PeriodO cites.\n\n        Once a Gazetteer's plato:gazetteer_status is 'published', its\n        attestations are append-only, and this is normative: an attestation is\n        never deleted or changed. What an attestation says includes its\n        facets and citations (plato:attests_name, attests_geometry,\n        attests_timespan, attests_type, attests_property, attests_identity,\n        plato:has_citation) whether or not they have IRIs of their own: a Name\n        shared under its IRI is not re-spelt once published, since that would\n        change every attestation pointing to it. The SpatialEntities and\n        Authorities that attestations are about or cite are not attestations,\n        and their descriptions may still be corrected and enriched. Every\n        attestation in a published Gazetteer should have a permanent IRI of\n        its own, since a correction or withdrawal must point to its target;\n        this is a recommendation, meant to become a requirement. A correction\n        is a new attestation with a meta-attestation (plato:Supersedes,\n        plato:Contradicts), and a\n        withdrawal is a meta-attestation of type plato:Retracts. Each carries\n        plato:created. The state as of any moment D is then a filter over the\n        data: the attestations created by D, less those superseded or\n        retracted by D. A supersession or retraction takes effect only while\n        it holds itself, so retracting a retraction restores its target, and\n        a chain of them resolves the same way; a cycle is an error in the\n        data. A platform can offer that state on request, by\n        datetime negotiation on the entity's IRI (RFC 7089, Memento); PLATO\n        recommends this but does not require it, since it is behaviour of a\n        server, not of data.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Gazetteer"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/dcat#Dataset"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#script",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        ISO 15924 script code (e.g., 'Arab' for Arabic script, 'Latn' for\n        Latin script, 'Hant' for Traditional Han characters). Important for\n        names that may appear in multiple scripts.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Name"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "script"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Uncertain",
    "@type": [
      "https://w3id.org/plato#CertaintyLevel"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The statement is doubtful: possible, but not established."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "uncertain"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#locator",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Where in the cited work the evidence sits: 'p. 412', 'f. 12v', 'Table\n        VI, col. 3, row 88', 's.v. Athlone', 'no. xix'. An uninterpreted\n        string, deliberately: sources locate themselves inconsistently, and\n        normalising the value would destroy exactly the information it is\n        there to carry. The same position and shape as PeriodO's source\n        locator.\n\n        A property of this citation, not of the source: one Source for a\n        printed gazetteer, a different locator on each attestation drawn\n        from it. Not to be confused with the spatial sense of 'locator' in\n        the plato:geometry_role comment, a proxy point standing in for an\n        entity.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Citation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "locator"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#created",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Timestamp when this attestation was created. This is the contribution\n        date, not the historical timespan being attested (use attests_timespan\n        for that). In a published Gazetteer it is the time axis along which an\n        earlier state is recomputed, so every attestation and meta-attestation\n        there should carry it.\n\n        Semantically equivalent to PROV-O's prov:generatedAtTime. We don't use\n        formal rdfs:subPropertyOf to avoid importing PROV-O constraints.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "created"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTime"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#open_start",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Boolean flag indicating that the start of this interval is deliberately\n        unspecified (not merely unknown). True for intervals like 'everything\n        before 1453' or 'prehistory until...'. Distinct from null start_earliest,\n        which indicates unknown start. Aligns with PeriodO's OpenBeginningInterval.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Timespan"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "open start"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#TranscriptionComplete",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Nothing of the value is lost."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#TranscriptionCompletenessScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "complete"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#relation_label",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Forward label for the relationship (e.g. 'capital_of')."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#RelationType"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "relation label"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#related_label",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        A name for the target of plato:relates_to, for display: 'the Buddha',\n        'denarius of Hadrian, BM 1872,0709.470'. It belongs on the attestation\n        rather than on the target, because the target may be someone else's\n        IRI, about which this dataset makes no other statement, and a platform\n        showing a place cannot reliably look up every IRI it links to. Give it\n        whenever the target is not a SpatialEntity in the same dataset; it is\n        harmless, but redundant, when the target is. It names the target; the\n        source's own wording of the relation is plato:source_label.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "related label"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Headword",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The editorial or preferred form under which the cited authority files the entry. A scholarly decision rather than a reading."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#FormStatusScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "headword"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#FeaturePoint",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The location of a specific central feature of the SpatialEntity, such as a market place or a church."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#GeometryRoleScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "feature point"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#value_json",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        A structured value serialised as JSON, whose shape is declared by\n        plato:value_type. Use plato:value_literal instead for scalar values.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#PropertyValue"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "structured value"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#cites",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The Authority (a Source or a Dataset) this Citation uses. Exactly one\n        per Citation: an attestation resting on two sources has two\n        Citations.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Citation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "cites"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#Authority"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#match_parameters",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The settings that produced the Candidate's score, as text (JSON\n        suggested, written in the JSON Canonicalization Scheme (RFC 8785), so\n        that the same settings are always the same text, since the text is\n        hashed into the Candidate's IRI): a threshold, the weights given to name, place and type,\n        the reference sources searched. With plato:algorithm_version it lets\n        a score be reproduced or explained. Optional; its form is the\n        software's own, since it describes a run of that software rather\n        than making a claim about places.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Candidate"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "match parameters"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#start_earliest",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The earliest possible start date for this timespan. Together with\n        start_latest, defines the uncertainty range for when the interval began.\n        Use ISO 8601 format (e.g., '1453-05-29') or a year of at least four\n        digits ('0921', '-12000') for year-level precision; deep-time years\n        have as many digits as they need, as in xsd:gYear. May be null for unknown or deliberately\n        open-beginning intervals.\n\n        The range is rdfs:Literal rather than a single datatype, because one\n        property carries values of three shapes. A plain string is conformant;\n        a producer that can type by shape should emit xsd:gYear for a year,\n        xsd:date for a day and xsd:dateTime otherwise, so that a store can\n        index and compare the bounds. The same applies to start_latest,\n        end_earliest and end_latest.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Timespan"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "start earliest"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Literal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#StanceReported",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The source passes it on without vouching for it: 'it is said', 'as Cambden noteth'."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#SourceStanceScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "reported"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#SourceStanceScheme",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Starter concepts for plato:source_stance. How firmly the source itself asserts what an attestation records, as distinct from anyone's confidence in it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "source stance"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#source_label",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The original label as given in the contributing source, before\n        vocabulary mapping. For a structured PropertyValue this preserves the\n        unparsed original — 'Monday after Whitsun, 3 days' — which is what a\n        future reader will want to check against the document. On a Name it is\n        the form as printed where the toponym has been normalised; on a\n        Geometry, the coordinates as printed ('03-47S/13038E', '??'); on a\n        Timespan, the date as written ('about 1841'). On an Attestation it is\n        the source's own wording of the relation the attestation asserts\n        ('part of Berkshire', 'within Buckingham'), before that relation is\n        mapped to a RelationType; an attestation asserts at most one relation,\n        so the wording is never ambiguous. Like the qualification properties it\n        has no rdfs:domain, so it applies to any facet node or attestation.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "source label"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#duration",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        How long the timespan lasted, as an xsd:duration ('P42D' for six\n        weeks, 'P1D' for a day), where the source states a length: a stay at\n        a stop on an itinerary, a siege, a fair. It may stand alone, when the\n        source gives a length and no dates, or beside the bounds, which it\n        does not replace. xsd:duration has no weeks, so weeks are written as\n        days; the source's own words ('staid 6 weekes') are\n        plato:source_label on the same timespan.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Timespan"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "duration"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#duration"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#TypeSegment",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A physical link with an existence of its own: a leg of a route between two stations, a reach of a river between confluences. Platforms may leave segments out of lists and searches of places."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#EntityKindScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "segment"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#contributor_url",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Website or profile URL for the contributor (personal website,\n        institutional page, project page, GitHub profile, etc.). Provides\n        additional context about the contributor's work and identity.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Contributor"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "contributor URL"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#TranscriptionCompletenessScheme",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Starter concepts for plato:transcription_completeness. Whether a transcribed value is whole, and if not, whether the lost part can be supplied."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "transcription completeness"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#LeadsTo",
    "@type": [
      "https://w3id.org/plato#RelationType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        A directed connection, from the subject (attests_about) to the target\n        (relates_to): one river flowing into another, a post road carrying\n        mail from one town to the next, letters sent from one city to\n        another. It joins two places; the reaches and legs of a network are\n        segments, whose direction is given by plato:BeginsAt and\n        plato:EndsAt. Not river-specific: a project declares its own narrower types ('flows\n        into', 'carries post to') with plato:broader_relation pointing here,\n        so that a consumer that knows only LeadsTo still follows them in the\n        right direction.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "leads to"
      }
    ],
    "https://w3id.org/plato#inverse_label": [
      {
        "@value": "reached_from"
      }
    ],
    "https://w3id.org/plato#relation_domain": [
      {
        "@value": "SpatialEntity"
      }
    ],
    "https://w3id.org/plato#relation_label": [
      {
        "@value": "leads_to"
      }
    ],
    "https://w3id.org/plato#relation_range": [
      {
        "@value": "SpatialEntity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#VariantOf",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A name defined as a variant of the anchor name."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#RelativeQualifierScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "variant of"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#identity_asserted_at",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#IdentityRelation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "asserted at"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTime"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#transcription_completeness",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Whether a transcribed value is whole: a concept in\n        plato:TranscriptionCompletenessScheme, plato:TranscriptionComplete,\n        plato:TranscriptionReconstructable (part is lost but can be supplied\n        with confidence) or plato:TranscriptionNonReconstructable (part is lost\n        and cannot be supplied). A different axis from accuracy: a damaged form\n        can be accurately read as far as it goes. No rdfs:domain, as for\n        accuracy.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "transcription completeness"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2004/02/skos/core#Concept"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#attests_type",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Links an Attestation to a Type classification it assigns to the SpatialEntity.\n        An attestation may assert multiple types or no type at all.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "attests type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#Type"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Itinerary",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A line tracing a route or journey."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#GeometryRoleScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "itinerary"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Challenges",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Questions the validity of the target attestation."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#MetaTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "challenges"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#TranscriptionFalse",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The transcribed form is not in the source at all: a ghost form, kept because it circulates and must be recognisable."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#TranscriptionAccuracyScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "false"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#precision_km",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Uncertainty radius in kilometres. For point geometries, indicates\n        how far the true location might be from the stated coordinates.\n        For polygons, indicates boundary uncertainty. Can be multiple values\n        for heterogeneous geometries.\n\n        Any XSD numeric datatype is accepted, zero or more (xsd:decimal, xsd:double,\n        xsd:float, xsd:integer and the others), so it has no rdfs:range.\n        PLATO tools writes a whole number as xsd:integer and any other as\n        xsd:double, as JSON-LD does.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Geometry"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "precision in kilometres"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#DuringReignOf",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A timespan defined by the reign or tenure of the anchor."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#RelativeQualifierScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "during reign of"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#type_identifier",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The concept's IRI in a controlled vocabulary: an AAT, Wikidata or\n        GeoNames concept, an OpenStreetMap tag. It should be a full IRI, not a\n        bare code ('PPL', 'Q687188', 'stream') whose vocabulary is known only\n        from somewhere else: that is what lets types from different sources be\n        compared. An OpenStreetMap tag's IRI carries its key\n        (https://wiki.openstreetmap.org/wiki/Tag:waterway=stream), since the\n        value alone is ambiguous. A source's own category that no vocabulary\n        holds is recorded as the Type's label and plato:source_label, with no\n        identifier, rather than as a code made up for it. The IRI is written\n        as a literal typed xsd:anyURI, never as an IRI object: that is what\n        the JSON-LD context and the spreadsheet tables produce, and one form\n        lets queries compare identifiers without converting them.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "type identifier"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#sequence",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The position of a member in an ordered whole, as one source gives it:\n        a station on a route, a stop on an itinerary, a segment of a road.\n        It sits on the attestation about the member, which relates_to the\n        route, itinerary or network with plato:MemberOf; the relates_to target\n        is what the number orders, so one place can hold different positions\n        on different routes. Lower numbers come first.\n\n        Two members with the same number are alternatives at that point (two\n        branches of a road); a source that disagrees with another about the\n        order is recorded as its own attestations, with a meta-attestation\n        where a judgement is made between them. A member with no sequence is\n        in an order the source does not give. The members of an itinerary\n        carry their own timespans, from arrival to departure, and the order of\n        a journey known only from its dates may be left to those timespans.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "sequence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#gazetteer_status",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Publication status: 'draft' or 'published'. From 'published' on, the Gazetteer's attestations are append-only (see plato:Gazetteer)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Gazetteer"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "status"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#StanceTentative",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The source states it, but with a hedge: 'as it seems', 'were (if not are)'."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#SourceStanceScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "tentative"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#authority_uri",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Authority"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "authority URI"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#attests_identity",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Links an Attestation to an IdentityRelation it asserts, so that\n        identity relations asserted in one act share its provenance: accepting\n        a cluster of n records is one attestation bundling the n-1 exactMatch\n        relations of the matches actually made, with the person, the time and\n        the cluster's definition as its source. Retracting or superseding the\n        attestation withdraws or amends them together. With plato:negated,\n        bundling one exactMatch relation, it says the two entities are not the\n        same. Closure may be taken within one such attestation only (see\n        plato:IdentityRelation). An IdentityRelation's own identity_asserted_by\n        and identity_sourced_by remain for one asserted on its own.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "attests identity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#IdentityRelation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Timespan",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        A temporal interval with start and end bounds. Timespans are\n        independent, reusable entities that may be shared across multiple\n        Attestations. Precision and uncertainty are expressed through\n        the start and end bound properties. Aligned with W3C Time Ontology\n        and compatible with PeriodO period definitions.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Timespan"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2006/time#ProperInterval"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#AttributionStated",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The source is named where the form occurs. The default attribution status, usually omitted."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#AttributionStatusScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "attribution stated"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Supersedes",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Replaces the target attestation with newer information."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#MetaTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "supersedes"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Bundles",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Groups the target with other related attestations."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#MetaTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "bundles"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#source_crs",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Original coordinate reference system. Typically 'EPSG:4326' (WGS84),\n        but may reference historical or custom CRS identifiers for historical\n        maps. Enables proper interpretation of coordinate values.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Geometry"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "source CRS"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#FormStatusScheme",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Starter concepts for plato:form_status. The status of the name form an attestation contributes."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "form status"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Attested",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A form read in the cited source. The default form status, usually omitted."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#FormStatusScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "attested"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#transliteration_system",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The transliteration/romanization system used (e.g., 'Pinyin' for\n        Chinese, 'BGN/PCGN' for Arabic, 'ISO 259' for Hebrew, 'Hepburn' for\n        Japanese). Enables proper interpretation and comparison of romanized\n        forms.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Name"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "transliteration system"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#relation_range",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Valid object type for this relation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#RelationType"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "range constraint"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#notes",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Free-text notes providing additional context about this attestation.\n        Can include transcriptions, translations, editorial comments, or\n        other information that doesn't fit structured fields.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "notes"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#BetweenXAndY",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Between the anchor and a second anchor."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#RelativeQualifierScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "between"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#TranscriptionInaccurate",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The transcription departs from what the source shows, by misreading or error, but is a reading of something the source contains."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#TranscriptionAccuracyScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "inaccurate"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Citation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        One attestation's use of one Authority: the qualified form of\n        plato:sourced_by. Carries what is true of this citation rather than\n        of the source or of the attestation: the locator within the work\n        (page, folio, column, table cell, entry), and whether the attribution\n        was stated in the source or inferred editorially. It carries no date.\n        The date of a witness belongs on the Source (plato:source_timespan)\n        and the date of the claim on the Attestation's Timespan.\n\n        An attestation resting on several sources has several Citations,\n        each with its own locator. Where there is nothing to say about the\n        citation, plato:sourced_by alone is sufficient.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Citation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#identity_sourced_by",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The Authority (Source or Dataset) that provides evidence for\n        this identity assertion, if any.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#IdentityRelation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "identity sourced by"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#Authority"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Extent",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The built or bounded extent of the SpatialEntity."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#GeometryRoleScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "extent"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#value_datatype",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Datatype of the literal value (e.g. xsd:integer, xsd:decimal, xsd:string)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#PropertyValue"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "value datatype"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#identity_object",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The second SpatialEntity in an identity assertion. Often a record in\n        another authority, such as a GeoNames feature or a Wikidata item,\n        which this range makes a SpatialEntity. That is intended: in PLATO\n        an authority record is a SpatialEntity like any other, identified by\n        its own URI, with its origin recorded in plato:namespace.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#IdentityRelation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "identity object"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#SpatialEntity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#TypeItinerary",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A journey made through places in order, each stop with its own timespan: a traveller's tour, a royal progress, a ship's voyage. Not plato:Itinerary, which is a geometry role (a line tracing a route or journey)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#EntityKindScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "itinerary"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#certainty_note",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Free-text explanation of the certainty assessment: quality of\n        evidence, degree of scholarly consensus, reliability of source\n        (e.g. 'manuscript partially illegible', 'coordinates extrapolated\n        from itinerary distances'). Applies wherever certainty does.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "certainty note"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#contributor_email",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Contact email address for the contributor. Useful for collaboration\n        and correspondence about contributed data.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Contributor"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "email"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Within",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Inside the anchor."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#RelativeQualifierScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "within"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#end_earliest",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The earliest possible end date for this timespan. Together with\n        end_latest, defines the uncertainty range for when the interval ended.\n        May be null for unknown or deliberately open-end intervals.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Timespan"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "end earliest"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Literal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#generated_at",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Candidate"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "generated at"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTime"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#open_end",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Boolean flag indicating that the end of this interval is deliberately\n        unspecified (not merely unknown). True for ongoing periods like 'Modern\n        era (1800-present)' or situations where the end does not exist. Aligns\n        with PeriodO's OpenEndInterval.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Timespan"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "open end"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Reconstructed",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A form inferred but not attested; the philologists' asterisked form."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#FormStatusScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "reconstructed"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#periodo_uri",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Link to a PeriodO period definition (https://perio.do/). When a timespan\n        corresponds to a standardized period in PeriodO, this property enables\n        alignment and allows PLATO to inherit PeriodO's temporal bounds, spatial\n        coverage, and cultural context. Example: 'https://n2t.net/ark:/99152/p06v8w4rb38'\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Timespan"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "PeriodO URI"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Contradicts",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Asserts that the target attestation is incorrect."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#MetaTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "contradicts"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#IdentityRelation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        An assertion that two SpatialEntities refer to the same real-world entity.\n        Carries its own provenance (who asserted it, on what basis),\n        certainty (how confident the assertion is), and identity semantics\n        (exactMatch, closeMatch, related).\n\n        Identity relations are distinct from scholarly entity-to-entity\n        relations, which describe substantive historical relationships\n        between different entities. They are also distinct from Candidates,\n        which are matches suggested by software and are claims by no one; a\n        relation made in answer to one points to it (plato:promoted_from).\n\n        An IdentityRelation is one attributed claim among many, never a\n        canonical statement of fact. A platform must not materialise identity\n        relations into merged records or minted identifiers, nor let one\n        outweigh contrary evidence by fiat: it is weighed like any other\n        evidence, and someone else may say the opposite (an attestation with\n        plato:negated bundling an exactMatch says two entities are not the\n        same).\n\n        Identity relations asserted together, as when a person accepts a\n        cluster of matches, are bundled by one Attestation\n        (plato:attests_identity), which carries their shared provenance and\n        is withdrawn or amended as a unit. A consumer may take the transitive\n        closure of exactMatch relations within one such attestation, and must\n        not chain identity relations across different attestations, nor\n        chain closeMatch, related or unspecified ones at all: A the same as B\n        and B the same as C, asserted by different people, is not anyone's\n        assertion that A is C.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Identity Relation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#start_latest",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The latest possible start date for this timespan. For certain dates,\n        this equals start_earliest. For uncertain dates, defines the end of\n        the uncertainty range for when the interval began.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Timespan"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "start latest"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Literal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#occurrence_count",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The number of times the attested form occurs in the cited source or\n        passage: the '(3 X)' of a place-name survey. A count of occurrences\n        of the form in this source, not of independent sources. It belongs to\n        the attestation, not to the Name, which may occur elsewhere.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "occurrence count"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#algorithm_version",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Candidate"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "algorithm version"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#timespan_label",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Human-readable label for this timespan (e.g., 'Byzantine period',\n        'Early Bronze Age', 'Ming Dynasty'). Particularly useful for named\n        periods referenced across multiple attestations. The date exactly as a\n        source writes it ('c. 925', 'a. 1300') is plato:source_label.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Timespan"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "timespan label"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#TranscriptionReconstructable",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Part of the value is lost, damaged or abbreviated, but can be supplied with confidence."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#TranscriptionCompletenessScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "reconstructable"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#OccurrenceContextScheme",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Starter concepts for plato:occurrence_context. The capacity in which an attested form occurs in its source."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "occurrence context"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#inverse_label",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Inverse label (e.g. 'has_capital')."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#RelationType"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "inverse label"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#relation_domain",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Valid subject type for this relation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#RelationType"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "domain constraint"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#InFieldName",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The form survives only as an element of a later minor name, such as a field name."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#OccurrenceContextScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "in field name"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#TranscriptionNonReconstructable",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Part of the value is lost and cannot be supplied."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#TranscriptionCompletenessScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "not reconstructable"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#DeathplaceOf",
    "@type": [
      "https://w3id.org/plato#RelationType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The subject is where the target person died."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "deathplace of"
      }
    ],
    "https://w3id.org/plato#inverse_label": [
      {
        "@value": "died_at"
      }
    ],
    "https://w3id.org/plato#relation_domain": [
      {
        "@value": "SpatialEntity"
      }
    ],
    "https://w3id.org/plato#relation_label": [
      {
        "@value": "deathplace_of"
      }
    ],
    "https://w3id.org/plato#relation_range": [
      {
        "@value": "person"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#FindspotOf",
    "@type": [
      "https://w3id.org/plato#RelationType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The target object (a coin, an inscription, a manuscript) was found at the subject. The timespan is when it was found, if known."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "findspot of"
      }
    ],
    "https://w3id.org/plato#inverse_label": [
      {
        "@value": "found_at"
      }
    ],
    "https://w3id.org/plato#relation_domain": [
      {
        "@value": "SpatialEntity"
      }
    ],
    "https://w3id.org/plato#relation_label": [
      {
        "@value": "findspot_of"
      }
    ],
    "https://w3id.org/plato#relation_range": [
      {
        "@value": "object"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Candidate",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        A match between two SpatialEntities suggested by software, for a person\n        to review: reconciliation against reference gazetteers (as in WHG's Map\n        your Data), record linkage, clustering. A Candidate carries a similarity\n        score, the algorithm's version, optionally the settings that produced\n        the score (plato:match_parameters), when it was generated, and the status\n        it had when its CandidateSet was issued, 'suggested'. It is a\n        claim by no one, and never becomes an IdentityRelation: a reviewer's\n        answer is an Attestation bundling an IdentityRelation that points back\n        through plato:promoted_from, a match or, with plato:negated, a denial.\n\n        A Candidate is published only in a CandidateSet, and is frozen from then\n        on, like a published attestation: never changed, never deleted, so that\n        a promoted_from pointing at it keeps its meaning. What became of it is\n        therefore derived, not stored. Take the attestations as of a moment\n        (those created by then, less those retracted or superseded; see\n        plato:Gazetteer) whose identity relations point at the Candidate: it is\n        accepted where some are and none is negated, rejected where some are\n        negated and none is not, answered both ways where there are both, and\n        unanswered where there are none. Identity is attributed, so a consumer\n        may ask this of one reviewer's or one gazetteer's attestations only.\n\n        Its IRI is a fragment of the IRI of the CandidateSet that publishes it,\n        minted from what it says: the set's IRI without any fragment, then '#c-'\n        and the first 8 hex digits (lower case) of the SHA-256 of a JSON array of\n        four strings, the source's IRI, the candidate's IRI, the algorithm\n        version and the match parameters (empty when there are none), written in\n        the JSON Canonicalization Scheme (RFC 8785) and hashed as UTF-8 with no\n        Unicode normalisation. Where 8 digits would begin like another\n        Candidate's hash, in its set or in an earlier set given to the minter,\n        it takes the shortest prefix, in steps of 4 digits, that differs from\n        every other. An IRI once published is never changed. A later set leaves\n        out a Candidate an earlier set already published, so each Candidate has\n        one IRI, under the set that first published it. The time it was\n        generated is not hashed. '#a-' is the form of an attestation's IRI,\n        never a Candidate's.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Candidate"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#sourced_by",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Links an Attestation to the Authority (typically a Source or Dataset)\n        that grounds it. This provides the provenance chain for the attestation.\n\n        Semantically equivalent to PROV-O's prov:wasDerivedFrom, indicating the\n        authority is the origin of the attested knowledge. We don't use formal\n        rdfs:subPropertyOf to avoid importing PROV-O's domain/range constraints\n        which conflict with PLATO's class structure.\n\n        This is the direct form. Where the citation itself has something to\n        say (a page or folio, an attribution resolved from 'ibidem'), use\n        plato:has_citation to a Citation node that cites the Authority.\n        sourced_by is declared as the property chain has_citation o cites, so\n        a reasoner derives it from a Citation; data intended for consumers\n        without a reasoner should assert it directly as well.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "sourced by"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#Authority"
      }
    ],
    "http://www.w3.org/2002/07/owl#propertyChainAxiom": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/plato#has_citation"
          },
          {
            "@id": "https://w3id.org/plato#cites"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#BeginsAt",
    "@type": [
      "https://w3id.org/plato#RelationType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        The subject segment begins at the target: a leg of an itinerary at the\n        station it leaves, a river reach at its upstream confluence. With\n        plato:EndsAt it gives a segment a direction. A segment with no\n        direction is joined to its two ends with plato:HasEnd.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "begins at"
      }
    ],
    "https://w3id.org/plato#inverse_label": [
      {
        "@value": "beginning_of"
      }
    ],
    "https://w3id.org/plato#relation_domain": [
      {
        "@value": "SpatialEntity (a segment)"
      }
    ],
    "https://w3id.org/plato#relation_label": [
      {
        "@value": "begins_at"
      }
    ],
    "https://w3id.org/plato#relation_range": [
      {
        "@value": "SpatialEntity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#promoted_from",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        Links an IdentityRelation to the Candidate it was made in response to,\n        preserving the algorithmic provenance. The answer may be yes or no: a\n        relation bundled by an Attestation marked plato:negated may point at the\n        Candidate it denies, as one in an accepting Attestation points at the\n        Candidate it accepts, so that a rejection is recorded, attributed and\n        dated like an acceptance. Its subject and object should be the Candidate's\n        source and candidate, in either order. Several relations, in different\n        attestations, may point at one Candidate (it was accepted, withdrawn and\n        accepted again, or two reviewers answered it); none of them changes it.\n        The Candidate is published in a CandidateSet, which should be published\n        wherever the dataset citing it is; a validator that has the set should\n        warn when promoted_from names no Candidate in it. Optional: identity\n        relations can also be asserted directly, without a prior Candidate.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/plato#IdentityRelation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "promoted from"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/plato#Candidate"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Supports",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Provides additional evidence for the target attestation."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#MetaTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "supports"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#LabelAnchor",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The anchor point of a map label."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#GeometryRoleScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "label anchor"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Direct",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The form refers to the SpatialEntity directly. The default occurrence context, usually omitted."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#OccurrenceContextScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "direct"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Annotates",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Adds a remark about the target attestation, with its own source, without supporting, contradicting or refining it. The remark is the meta-attestation's notes."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#MetaTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "annotates"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#Editorial",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A form written by the editors of the cited edition in their own words (commentary, apparatus, notes), not a form the edited source itself contains."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/plato#FormStatusScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "editorial"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Use it when the citation is to an edition and the name occurs in the editors' text, not in the edited text. It says nothing about whether the place's name is attested elsewhere. Attested remains the default for forms the source contains."
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#BirthplaceOf",
    "@type": [
      "https://w3id.org/plato#RelationType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The subject is where the target person was born."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "https://w3id.org/plato#authority_title": [
      {
        "@language": "en",
        "@value": "birthplace of"
      }
    ],
    "https://w3id.org/plato#inverse_label": [
      {
        "@value": "born_at"
      }
    ],
    "https://w3id.org/plato#relation_domain": [
      {
        "@value": "SpatialEntity"
      }
    ],
    "https://w3id.org/plato#relation_label": [
      {
        "@value": "birthplace_of"
      }
    ],
    "https://w3id.org/plato#relation_range": [
      {
        "@value": "person"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#AttributionStatusScheme",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Starter concepts for plato:attribution_status. Whether the attribution of evidence to a cited source was stated or resolved editorially."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "attribution status"
      }
    ]
  },
  {
    "@id": "https://w3id.org/plato#relative_qualifier",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\n        A controlled-vocabulary term describing the relative relationship\n        when bearing and distance are not applicable or not sufficient.\n        Should point to a concept in a SKOS concept scheme (e.g.\n        plato:Near, plato:Within, plato:Beyond, plato:UpstreamOf,\n        plato:BetweenXAndY, plato:DuringReignOf, plato:VariantOf).\n        Using URIs rather than free text enables machine reconciliation\n        across gazetteers that describe relativity differently.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "_:ne8cfdc39ccf14eb98b3581d86d7bdceab19"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/plato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "relative qualifier"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2004/02/skos/core#Concept"
      }
    ]
  },
  {
    "@id": "_:ne8cfdc39ccf14eb98b3581d86d7bdceab19",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2002/07/owl#unionOf": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/plato#Name"
          },
          {
            "@id": "https://w3id.org/plato#Geometry"
          },
          {
            "@id": "https://w3id.org/plato#Timespan"
          },
          {
            "@id": "https://w3id.org/plato#Type"
          }
        ]
      }
    ]
  }
]