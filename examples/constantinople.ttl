@prefix plato: <https://w3id.org/plato#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix whgx: <https://whgazetteer.org/example/> .

# The "whgx:" prefix is used throughout these examples for illustrative
# URIs that represent WHG entities (SpatialEntities, Attestations, Names, etc.).
# In a production system these would be real, resolvable WHG identifiers.
# External URIs that already exist (AAT, GeoNames) are used directly.


# =============================================================================
# Constantinople / Istanbul in three sources
#
# This example demonstrates the core attestation-as-bundle pattern:
# a single SpatialEntity with multiple Attestations, each bundling a different
# Name and Timespan (and, where the source gives one, a Geometry), sourced
# from different authorities:
#
#   - Herodotus, Histories 4.144.2, who writes that Megabazus was "at
#     Byzantion" (ἐν Βυζαντίῳ);
#   - the Notitia Urbis Constantinopolitanae, a fifth-century list of the
#     city's regions and buildings, whose preface names the city
#     "urbis Constantinopolitanae";
#   - GeoNames, feature 745044, which gives the current Turkish name
#     İstanbul and a point.
#
# The key properties to observe:
#   - One SpatialEntity, three Attestations.
#   - Names, Geometries, and Timespans are independent, reusable nodes.
#   - Each Attestation bundles a specific combination with provenance.
#   - No data is overwritten when a new source is added.
#   - Each Timespan is the date its source witnesses, not the span of years
#     in which the name was in use.
# =============================================================================


# -----------------------------------------------------------------------------
# The SpatialEntity: a single, stable identity
# -----------------------------------------------------------------------------

whgx:entity\/constantinople
    a plato:SpatialEntity ;
    plato:entity_identifier "constantinople" ;
    plato:namespace "whg" ;
    plato:ccodes "TR" .


# -----------------------------------------------------------------------------
# Names
#
# Where the source writes the name in an inflected form, the toponym is the
# normalised form and plato:source_label keeps the form as the source prints
# it.
# -----------------------------------------------------------------------------

whgx:name\/byzantion-grc
    a plato:Name ;
    plato:toponym "Βυζάντιον" ;
    plato:language "grc" ;
    plato:script "Grek" ;
    plato:romanized "Byzantion" ;
    plato:transliteration_system "ISO 843" ;
    plato:name_type "toponym" ;
    plato:source_label "Βυζαντίῳ" .

whgx:name\/constantinopolis-la
    a plato:Name ;
    plato:toponym "Constantinopolis" ;
    plato:language "la" ;
    plato:script "Latn" ;
    plato:name_type "toponym" ;
    plato:source_label "urbis Constantinopolitanae" .

whgx:name\/istanbul-tr
    a plato:Name ;
    plato:toponym "İstanbul" ;
    plato:language "tr" ;
    plato:script "Latn" ;
    plato:name_type "toponym" .


# -----------------------------------------------------------------------------
# Geometries
#
# Only GeoNames gives coordinates. Herodotus and the Notitia name the city
# but do not locate it, so their attestations attest no geometry: a point
# added by the encoder would be the encoder's claim, not the source's.
# -----------------------------------------------------------------------------

whgx:geometry\/geonames-point
    a plato:Geometry ;
    plato:geo_wkt "POINT(28.94966 41.01384)"^^<http://www.opengis.net/ont/geosparql#wktLiteral> ;
    plato:repr_point "POINT(28.94966 41.01384)"^^<http://www.opengis.net/ont/geosparql#wktLiteral> ;
    plato:source_crs "EPSG:4326" .


# -----------------------------------------------------------------------------
# Timespans
#
# Each is the date of its source, with bounds as wide as the evidence for
# that date requires.
# -----------------------------------------------------------------------------

whgx:timespan\/herodotus-histories
    a plato:Timespan ;
    plato:start_earliest "-0440" ;
    plato:end_latest "-0420" ;
    plato:start_precision "decade" ;
    plato:end_precision "decade" .

whgx:timespan\/notitia-urbis
    a plato:Timespan ;
    plato:start_earliest "0425" ;
    plato:end_latest "0450" ;
    plato:start_precision "decade" ;
    plato:end_precision "year" .

whgx:timespan\/geonames-consulted
    a plato:Timespan ;
    plato:start_earliest "2026-09-30" ;
    plato:end_latest "2026-09-30" ;
    plato:start_precision "day" ;
    plato:end_precision "day" .


# -----------------------------------------------------------------------------
# Types
#
# The AAT URI is the real, resolvable identifier for this concept.
# -----------------------------------------------------------------------------

whgx:type\/inhabited-place
    a plato:Type ;
    plato:type_identifier "http://vocab.getty.edu/aat/300008347"^^xsd:anyURI ;
    plato:type_label "inhabited place" .


# -----------------------------------------------------------------------------
# Sources
# -----------------------------------------------------------------------------

whgx:source\/herodotus-histories
    a plato:Source ;
    plato:authority_title "Herodotus, Histories IV.144" ;
    plato:bibliographic_string "Hdt. 4.144.2" ;
    plato:authority_uri "https://www.perseus.tufts.edu/hopper/text?doc=Perseus:text:1999.01.0125:book=4:chapter=144"^^xsd:anyURI .

whgx:source\/notitia-urbis
    a plato:Source ;
    plato:authority_title "Notitia Urbis Constantinopolitanae" ;
    plato:bibliographic_string "Notitia Urbis Constantinopolitanae, praefatio, ed. O. Seeck, Notitia Dignitatum (1876), p. 229" ;
    plato:authority_uri "https://www.livius.org/sources/content/notitia-urbis-constantinopolitanae/"^^xsd:anyURI .

whgx:source\/geonames
    a plato:Source ;
    plato:authority_title "GeoNames" ;
    plato:bibliographic_string "GeoNames, feature 745044 (Istanbul)" ;
    plato:authority_uri "https://www.geonames.org/745044/"^^xsd:anyURI .


# -----------------------------------------------------------------------------
# A contributor
# -----------------------------------------------------------------------------

whgx:org\/byzantine-institute
    a plato:Organization ;
    rdfs:label "Byzantine Studies Institute" .

whgx:contributor\/historian
    a plato:Contributor ;
    plato:contributor_name "Maria Komnena" ;
    plato:contributor_orcid "https://orcid.org/0000-0003-9876-5432" ;
    plato:contributor_affiliation whgx:org\/byzantine-institute ;
    plato:contributor_role "data_curator" .


# -----------------------------------------------------------------------------
# Attestation 1: Byzantion, in Herodotus
# -----------------------------------------------------------------------------

whgx:attestation\/byzantion-herodotus
    a plato:Attestation ;
    plato:attests_about whgx:entity\/constantinople ;
    plato:attests_name whgx:name\/byzantion-grc ;
    plato:attests_timespan whgx:timespan\/herodotus-histories ;
    plato:attests_type whgx:type\/inhabited-place ;
    plato:sourced_by whgx:source\/herodotus-histories ;
    plato:contributed_by whgx:contributor\/historian ;
    plato:certainty 1.0 ;
    plato:certainty_note "The source names the city: Megabazus was 'at Byzantion' (ἐν Βυζαντίῳ). It gives no location, so no geometry is attested." ;
    plato:notes "The timespan is the date of the source, not the span in which the name Byzantion was used. The Histories are usually dated about 440 BC; nothing in them can be dated with certainty after 430 BC, and Herodotus is thought to have died about 425 BC. The bounds are set wide enough to cover both." ;
    plato:created "2026-02-15T10:00:00Z"^^xsd:dateTime .


# -----------------------------------------------------------------------------
# Attestation 2: Constantinopolis, in the Notitia Urbis
# -----------------------------------------------------------------------------

whgx:attestation\/constantinopolis-notitia
    a plato:Attestation ;
    plato:attests_about whgx:entity\/constantinople ;
    plato:attests_name whgx:name\/constantinopolis-la ;
    plato:attests_timespan whgx:timespan\/notitia-urbis ;
    plato:attests_type whgx:type\/inhabited-place ;
    plato:sourced_by whgx:source\/notitia-urbis ;
    plato:contributed_by whgx:contributor\/historian ;
    plato:certainty 1.0 ;
    plato:certainty_note "The preface names the city 'urbis Constantinopolitanae'. The source describes the city's fourteen regions but gives no coordinates, so no geometry is attested." ;
    plato:notes "The timespan is the date of the source, not the span in which the name Constantinopolis was used. The Notitia was written under Theodosius II, who died in 450, and whom its preface praises; proposed dates run from about 425 to 447-450." ;
    plato:created "2026-02-15T10:00:00Z"^^xsd:dateTime .


# -----------------------------------------------------------------------------
# Attestation 3: İstanbul, in GeoNames
# -----------------------------------------------------------------------------

whgx:attestation\/istanbul-geonames
    a plato:Attestation ;
    plato:attests_about whgx:entity\/constantinople ;
    plato:attests_name whgx:name\/istanbul-tr ;
    plato:attests_geometry whgx:geometry\/geonames-point ;
    plato:attests_timespan whgx:timespan\/geonames-consulted ;
    plato:attests_type whgx:type\/inhabited-place ;
    plato:sourced_by whgx:source\/geonames ;
    plato:contributed_by whgx:contributor\/historian ;
    plato:certainty 1.0 ;
    plato:certainty_note "GeoNames gives İstanbul as the official Turkish name, and a single point for the city; the point stands for the whole city and marks no boundary." ;
    plato:notes "The timespan is the day GeoNames was consulted. A modern gazetteer witnesses the current name, not when the name came into use." ;
    plato:created "2026-02-15T10:00:00Z"^^xsd:dateTime .


# -----------------------------------------------------------------------------
# Identity: the same place in GeoNames
#
# Not an attestation but a separate claim, with its own basis. In the
# place-centric JSON it is nested under the SpatialEntity, which supplies
# identity_subject, so the JSON gives no subject.
# -----------------------------------------------------------------------------

whgx:identity\/constantinople-geonames
    a plato:IdentityRelation ;
    plato:identity_subject whgx:entity\/constantinople ;
    plato:identity_object <https://sws.geonames.org/745044/> ;
    plato:identity_type "closeMatch" ;
    plato:identity_basis "GeoNames describes the modern city: the same settlement, with a different extent." .


# =============================================================================
# Observations
#
# 1. All three attestations point to the same SpatialEntity. The identity persists;
#    the evidence is layered.
#
# 2. Each Name is an independent node. "İstanbul" could also appear in
#    attestations for other SpatialEntities if needed.
#
# 3. Adding a fourth source means adding a new Attestation, with its own
#    Name and Timespan (and Geometry, if the source gives one) — nothing is
#    overwritten.
#
# 4. If a scholar wants to locate Byzantion from other evidence, such as
#    archaeology, they create a new Attestation with a Geometry and that
#    Source — both attestations coexist, with their own certainty and
#    provenance.
#
# 5. Each date is what its source witnesses: Herodotus's Histories, the
#    Notitia's composition, the day GeoNames was consulted. None of them is
#    the period in which the name was used. That period is a conclusion
#    drawn from many attestations, not a fact any one source records; a
#    named period, where one is wanted, goes in plato:timespan_label.
# =============================================================================
